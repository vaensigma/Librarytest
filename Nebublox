local function Create(class, props)
    local ok, inst = pcall(Instance.new, class)
    if not ok or not inst then
        local f = Instance.new("Frame")
        f.Visible = false
        f.Name = class .. "_Error"
        return f
    end
    local parent = nil
    if props then
        for k, v in pairs(props) do
            if k == "Parent" then
                parent = v
            else
                pcall(function() inst[k] = v end)
            end
        end
    end
    if parent then pcall(function() inst.Parent = parent end) end
    return inst
end

local function Round(inst, r)
    Create("UICorner", { CornerRadius = UDim.new(0, r or 10), Parent = inst })
end

local function Stroke(inst, color, thickness, transparency)
    return Create("UIStroke", {
        Color = color or T.Stroke,
        Thickness = thickness or 1,
        Transparency = transparency or 0.4,
        Parent = inst,
    })
end

local function AddTextStroke(inst)
    if T.TextStroke <= 0 then return end
    Create("UIStroke", {
        Color = Color3.new(0, 0, 0),
        Thickness = T.TextStroke,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
        Parent = inst,
    })
end

local function Tween(obj, props, time, style, dir)
    if not obj or not obj.Parent then return nil end
    local t = TweenService:Create(obj,
        TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Sine, dir or Enum.EasingDirection.Out),
        props)
    t:Play()
    return t
end

local function Fire(cb, ...)
    if type(cb) ~= "function" then return end
    task.spawn(function(...)
        local ok, err = pcall(cb, ...)
        if not ok then warn("[Nebublox] Callback error: " .. tostring(err)) end
    end, ...)
end

local function Track(conn)
    table.insert(Nebublox.Conns, conn)
    return conn
end

-- holographic animated gradient (Nebublox soul)
local function MakeHolographic(label)
    local g = Create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, T.Accent),
            ColorSequenceKeypoint.new(1, T.Accent2),
        }),
        Parent = label,
    })
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        if not label or not label.Parent then
            if conn then conn:Disconnect() end
            return
        end
        g.Rotation = (g.Rotation + dt * 60) % 360
    end)
    table.insert(Nebublox.Conns, conn)
    return g
end

-- ==================================================================
--  FPS TRACKER
-- ==================================================================
local FPS = { value = 60, history = {} }
do
    local acc, frames = 0, 0
    Track(RunService.RenderStepped:Connect(function(dt)
        acc = acc + dt
        frames = frames + 1
        if acc >= 0.5 then
            FPS.value = math.floor(frames / acc + 0.5)
            table.insert(FPS.history, FPS.value)
            if #FPS.history > 60 then table.remove(FPS.history, 1) end
            acc, frames = 0, 0
        end
    end))
end

