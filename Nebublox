function Nebublox.Utils.SetWalkspeed(n) local h = getHumanoid(); if h then h.WalkSpeed = n end end
function Nebublox.Utils.SetJumpPower(n)
    local h = getHumanoid()
    if h then h.UseJumpPower = true; h.JumpPower = n end
end

local _flying, _flyConn, _flySpeed = false, nil, 100
function Nebublox.Utils.Fly(enable, speed)
    if speed then _flySpeed = speed end
    local hum, hrp = getHumanoid(), getHRP()
    if enable then
        if _flying or not hum or not hrp then return end
        _flying = true
        hum.PlatformStand = true
        _flyConn = RunService.RenderStepped:Connect(function(dt)
            local h, r = getHumanoid(), getHRP()
            if not h or not r or h.Health <= 0 then
                Nebublox.Utils.Fly(false)
                return
            end
            local cam = Workspace.CurrentCamera
            local cf = cam.CFrame
            local dir = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cf.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cf.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
            if UserInputService.TouchEnabled then dir = dir + h.MoveDirection end
            r.AssemblyLinearVelocity = Vector3.new()
            if dir.Magnitude > 0 then
                r.CFrame = r.CFrame + dir.Unit * _flySpeed * dt
            end
        end)
    else
        if not _flying then return end
        _flying = false
        if _flyConn then _flyConn:Disconnect(); _flyConn = nil end
        if hum then hum.PlatformStand = false end
    end
end

local _infiniteJumpEnabled, _jumpConn = false, nil
function Nebublox.Utils.InfiniteJump(enable)
    if enable and not _infiniteJumpEnabled then
        _infiniteJumpEnabled = true
        _jumpConn = UserInputService.JumpRequest:Connect(function()
            local h = getHumanoid()
            if h and _infiniteJumpEnabled then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end)
    elseif not enable and _infiniteJumpEnabled then
        _infiniteJumpEnabled = false
        if _jumpConn then _jumpConn:Disconnect(); _jumpConn = nil end
    end
end

local _frozenState = false
local _oldWS, _oldJP, _oldPlatformStand, _oldAnchor = nil, nil, nil, nil
function Nebublox.Utils.FreezeLocalCharacter(enable)
    local hum, hrp = getHumanoid(), getHRP()
    if not hum or not hrp then return end
    if enable and not _frozenState then
        _frozenState = true
        _oldWS, _oldJP, _oldPlatformStand, _oldAnchor = hum.WalkSpeed, hum.JumpPower, hum.PlatformStand, hrp.Anchored
        hum.WalkSpeed = 0; hum.JumpPower = 0; hum.PlatformStand = true; hrp.Anchored = true
    elseif not enable and _frozenState then
        _frozenState = false
        if _oldWS ~= nil then hum.WalkSpeed = _oldWS end
        if _oldJP ~= nil then hum.JumpPower = _oldJP end
        if _oldPlatformStand ~= nil then hum.PlatformStand = _oldPlatformStand end
        if _oldAnchor ~= nil then hrp.Anchored = _oldAnchor end
        _oldWS, _oldJP, _oldPlatformStand, _oldAnchor = nil, nil, nil, nil
    end
end

local _xrayStates = {}
function Nebublox.Utils.ToggleXRay(enable, targetTransparency, excludeCharacters)
    targetTransparency = targetTransparency or 0.6
    excludeCharacters = excludeCharacters == nil and true or excludeCharacters
    local chars = {}
    if excludeCharacters then
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then table.insert(chars, p.Character) end
        end
    end
    if enable then
        for _, part in ipairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                local skip = false
                for _, c in ipairs(chars) do
                    if part:IsDescendantOf(c) then skip = true; break end
                end
                if not skip then
                    if _xrayStates[part] == nil then _xrayStates[part] = part.Transparency end
                    part.Transparency = targetTransparency
                end
            end
        end
    else
        for part, tr in pairs(_xrayStates) do
            if part and part.Parent then part.Transparency = tr end
        end
        _xrayStates = {}
    end
end

local _oldFogValues = nil
function Nebublox.Utils.ToggleFog(enable)
    local lighting = Services.Lighting
    if not lighting then return end
    if enable then
        if _oldFogValues == nil then
            _oldFogValues = { Color = lighting.FogColor, Start = lighting.FogStart, End = lighting.FogEnd }
        end
        lighting.FogStart = 0
        lighting.FogEnd = 9e9
    else
        if _oldFogValues ~= nil then
            lighting.FogColor = _oldFogValues.Color
            lighting.FogStart = _oldFogValues.Start
            lighting.FogEnd = _oldFogValues.End
            _oldFogValues = nil
        end
    end
end

local _activeESPTags = {}
function Nebublox.Utils.DetachESP(target)
    local tag = _activeESPTags[target]
    if tag then
        if tag.Billboard then tag.Billboard:Destroy() end
        if tag.Highlight then tag.Highlight:Destroy() end
        _activeESPTags[target] = nil
        return true
    end
    return false
end

function Nebublox.Utils.DetachAllESP()
    for target in pairs(_activeESPTags) do Nebublox.Utils.DetachESP(target) end
end

-- espType: "Billboard" | "Highlight" | "Both"
function Nebublox.Utils.AttachESP(target, espType, options)
    options = options or {}
    if not target then return nil end
    Nebublox.Utils.DetachESP(target)
    espType = espType or "Billboard"
    local tag = {}
    local safeParent = getSafeCoreGui()
    local model = target:IsA("Humanoid") and target.Parent or target

    if espType == "Billboard" or espType == "Both" then
        local adornee = target
        if target:IsA("Humanoid") then
            adornee = target.Parent and (target.Parent:FindFirstChild("Head") or target.Parent:FindFirstChild("HumanoidRootPart"))
        elseif target:IsA("Model") then
            adornee = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
        end
        if adornee and adornee:IsA("BasePart") then
            local billboard = Instance.new("BillboardGui")
            billboard.Adornee = adornee
            billboard.Size = UDim2.new(0, 150, 0, 30)
            billboard.AlwaysOnTop = true
            billboard.StudsOffset = Vector3.new(0, adornee.Size.Y / 2 + 1.5, 0)
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.TextScaled = true
            lbl.Font = Enum.Font.GothamBold
            lbl.TextColor3 = options.Color or Color3.fromRGB(255, 255, 0)
            lbl.TextStrokeTransparency = 0
            lbl.Text = options.Text or (target:IsA("Humanoid") and target.Parent and target.Parent.Name) or target.Name
            lbl.Parent = billboard
            billboard.Parent = safeParent
            tag.Billboard = billboard
        end
    end

    if (espType == "Highlight" or espType == "Both") and model and model:IsA("Instance") then
        local hl = Instance.new("Highlight")
        hl.Adornee = model
        hl.FillColor = options.Color or Color3.fromRGB(255, 255, 0)
        hl.OutlineColor = options.OutlineColor or Color3.new(1, 1, 1)
        hl.FillTransparency = options.FillTransparency or 0.6
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = safeParent
        tag.Highlight = hl
    end

    if not tag.Billboard and not tag.Highlight then return nil end
    _activeESPTags[target] = tag
    return tag.Billboard or tag.Highlight
end

function Nebublox.Utils.CreateWebSocket(url)
    local WebSocketAPI = genv.WebSocket
    if not WebSocketAPI then return nil end
    local client = {
        OnMessage = Instance.new("BindableEvent"),
        OnClose = Instance.new("BindableEvent"),
        OnError = Instance.new("BindableEvent")
    }
    local success, ws = pcall(function()
        if type(WebSocketAPI) == "table" then
            local connect = WebSocketAPI.Connect or WebSocketAPI.connect
            if connect then return connect(url) end
        elseif type(WebSocketAPI) == "function" then
            return WebSocketAPI(url)
        end
    end)
    if not success or not ws then return nil end
    client.Connection = ws
    if ws.OnMessage then ws.OnMessage:Connect(function(msg, bin) client.OnMessage:Fire(msg, bin) end) end
    if ws.OnClose then ws.OnClose:Connect(function(code, res) client.OnClose:Fire(code, res) end) end
    if ws.OnError then ws.OnError:Connect(function(msg) client.OnError:Fire(msg) end) end
    function client:Send(data, bin) if self.Connection then pcall(self.Connection.Send, self.Connection, data, bin) end end
    function client:Close(code, res) if self.Connection then pcall(self.Connection.Close, self.Connection, code, res) end end
    return client
end

function Nebublox.Utils.GetNearestPlayer(maxDistance)
    local localPlayer = Nebublox.Utils.GetLocalPlayer()
    local hrp = getHRP()
    if not hrp then return nil end
    local nearest, minDistance = nil, maxDistance or math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < minDistance then minDistance = dist; nearest = p end
        end
    end
    return nearest
end

function Nebublox.Utils.Cleanup()
    pcall(Nebublox.Utils.Fly, false)
    pcall(Nebublox.Utils.InfiniteJump, false)
    pcall(Nebublox.Utils.FreezeLocalCharacter, false)
    pcall(Nebublox.Utils.ToggleXRay, false)
    pcall(Nebublox.Utils.ToggleFog, false)
    pcall(Nebublox.Utils.DetachAllESP)
end

