        TextColor3 = T.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = btn,
    })
    AddTextStroke(l)
    local valueLabel = Create("TextLabel", {
        Size = UDim2.new(1, -40, 0, 15),
        Position = UDim2.new(0, 12, 0, 22),
        BackgroundTransparency = 1,
        Text = current ~= nil and tostring(current) or "—",
        Font = T.FontBold,
        TextSize = 13,
        TextColor3 = T.Accent,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = btn,
    })
    AddTextStroke(valueLabel)
    local arrow = Create("TextLabel", {
        Size = UDim2.new(0, 20, 1, 0),
        Position = UDim2.new(1, -26, 0, 0),
        BackgroundTransparency = 1,
        Text = "▾",
        TextSize = 14,
        TextColor3 = T.TextDim,
        Parent = btn,
    })
    local optionsHolder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Visible = false,
        LayoutOrder = 2,
        Parent = holder,
    })
    Create("UIListLayout", { Padding = UDim.new(0, 2), Parent = optionsHolder })

    local el = { Type = "Dropdown", OptionButtons = {} }
    local open = false

    local function setOpen(v)
        open = v
        optionsHolder.Visible = v
        arrow.Text = v and "▴" or "▾"
        Tween(holder, { BackgroundTransparency = v and 0 or T.Glass }, 0.15)
    end

    local function select(opt, silent)
        current = opt
        valueLabel.Text = opt ~= nil and tostring(opt) or "—"
        for o, lbl in pairs(el.OptionButtons) do
            lbl.TextColor3 = (o == opt) and T.Accent or T.TextDim
        end
        if not silent then Fire(data.Callback, opt) end
    end

    el.Set = function(_, v, silent)
        if v ~= nil then select(v, silent) end
    end
    el.Get = function() return current end

    function el.Refresh(newOptions)
        options = newOptions or {}
        for _, pairEntry in pairs(el.OptionButtons) do
            -- nothing (buttons destroyed below via list)
        end
        for _, child in ipairs(optionsHolder:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        el.OptionButtons = {}
        for _, opt in ipairs(options) do
            local obtn = Create("TextButton", {
                Size = UDim2.new(1, 0, 0, 28),
                BackgroundColor3 = T.Sidebar,
                Text = "",
                AutoButtonColor = false,
                Parent = optionsHolder,
            })
            Round(obtn, 6)
            local olbl = Create("TextLabel", {
                Size = UDim2.new(1, -20, 1, 0),
                Position = UDim2.new(0, 10, 0, 0),
                BackgroundTransparency = 1,
                Text = tostring(opt),
                Font = T.Font,
                TextSize = 12,
                TextColor3 = (opt == current) and T.Accent or T.TextDim,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = obtn,
            })
            AddTextStroke(olbl)
            el.OptionButtons[opt] = olbl
            obtn.MouseButton1Click:Connect(function()
                select(opt)
                setOpen(false)
            end)
        end
    end

    if flag then Nebublox.Flags[flag] = el end
    btn.MouseButton1Click:Connect(function() setOpen(not open) end)
    el.Refresh(options)
    if current ~= nil then select(current, true) end
    return el
end

