        pcall(function()
            local m = UserInputService:GetMouseLocation()
            local inset = game:GetService("GuiService"):GetGuiInset()
            local fx = math.clamp((m.X - btn.AbsolutePosition.X) / math.max(btn.AbsoluteSize.X, 1), 0, 1)
            local fy = math.clamp((m.Y - inset.Y - btn.AbsolutePosition.Y) / math.max(btn.AbsoluteSize.Y, 1), 0, 1)
            local rip = Create("Frame", {
                Size = UDim2.fromOffset(8, 8), Position = UDim2.new(fx, 0, fy, 0), AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.7, ZIndex = 50, Parent = btn
            }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})
            local tw = Tween(rip, {Size = UDim2.fromOffset(300, 300), BackgroundTransparency = 1}, 0.5, Enum.EasingStyle.Quad)
            if tw then tw.Completed:Connect(function() rip:Destroy() end) else rip:Destroy() end
        end)
    end)

    local obj = { Frame = btn, btn = btn, flag = data.Flag }
