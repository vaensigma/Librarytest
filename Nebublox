genv.Nebublox_KeyConn = UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or genv.Nebublox_Binding then return end
    if input.KeyCode == genv.Nebublox_UIKeybind then SetUIVisible(not UI_Visible) end
end)

local function MakeDraggable(topBar, frame)
    local dragging, dragInput, dragStart, startPos
    local d1 = topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    local d2 = topBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    local d3 = UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            local vp = Workspace.CurrentCamera.ViewportSize
            local sizeX = frame.AbsoluteSize.X
            local sizeY = frame.AbsoluteSize.Y

            local minX = sizeX * frame.AnchorPoint.X
            local maxX = vp.X - (sizeX * (1 - frame.AnchorPoint.X))
            local minY = sizeY * frame.AnchorPoint.Y
            local maxY = vp.Y - (sizeY * (1 - frame.AnchorPoint.Y))

            local cx = startPos.X.Offset + (vp.X * startPos.X.Scale)
            local cy = startPos.Y.Offset + (vp.Y * startPos.Y.Scale)

            frame.Position = UDim2.new(0, math.clamp(cx + delta.X, minX, maxX), 0, math.clamp(cy + delta.Y, minY, maxY))
        end
    end)
    local d4 = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    frame.Destroying:Connect(function()
        d1:Disconnect(); d2:Disconnect(); d3:Disconnect(); d4:Disconnect()
    end)
end

