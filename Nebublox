    function WindowObj:SelectTab(target)
        local selectedTab = nil
        if type(target) == "number" then
            selectedTab = self.Tabs[target]
        elseif type(target) == "string" then
            for _, t in ipairs(self.Tabs) do
                if t.Name:lower() == target:lower() then selectedTab = t; break end
            end
        elseif type(target) == "table" then
            selectedTab = target
        end
        if not selectedTab then return end
        if self.SearchBox then self.SearchBox.Text = "" end
        if self.ActiveTab == selectedTab then return end

        for _, t in ipairs(self.Tabs) do
            local isSel = (t == selectedTab)
            if t.Button then
                Tween(t.Button, {BackgroundColor3 = isSel and T.PrimaryAccent or T.Card, BackgroundTransparency = isSel and 0 or 0.2})
                local gl = t.Button:FindFirstChild("Glow")
                if gl then Tween(gl, {Transparency = isSel and 0.55 or 1}) end
                local lbl = t.Button:FindFirstChild("TabTitle")
                if lbl then Tween(lbl, {TextColor3 = isSel and T.Background or T.PrimaryAccent}) end
                local ic = t.Button:FindFirstChild("TabIcon")
                if ic and ic:IsA("ImageLabel") then Tween(ic, {ImageColor3 = isSel and T.Background or T.TextHeader}) end
            end
            if t.Container then
                if isSel and not t.Container.Visible then
                    t.Container.Position = UDim2.new(0, 0, 0, 14)
                    Tween(t.Container, {Position = UDim2.new(0, 0, 0, 0)}, 0.28, Enum.EasingStyle.Quint)
                end
                t.Container.Visible = isSel
            end
        end
        self.ActiveTab = selectedTab
    end

