local function SetRect(inst, pos, size)
    pcall(function() inst.ImageRectOffset = pos end)
    pcall(function() inst.ImageRectSize = size end)
end

function Nebublox.Assets:ApplyImage(imageLabel, assetName)
    if not (typeof(imageLabel) == "Instance" and (imageLabel:IsA("ImageLabel") or imageLabel:IsA("ImageButton"))) then return false end
    local directIcon = self.Icons[assetName]
    if directIcon then
        imageLabel.Image = directIcon
        SetRect(imageLabel, Vector2.new(0, 0), Vector2.new(0, 0))
        return true
    end
    local spriteData = self.SpriteData[assetName]
    if spriteData then
        local sheetId = self.Spritesheets[spriteData.Sheet]
        if sheetId then
            imageLabel.Image = sheetId
            SetRect(imageLabel, spriteData.Position, spriteData.Size)
            return true
        end
    end
    return false
end

local function ApplyIcon(inst, iconName)
    if not iconName or not (typeof(inst) == "Instance" and (inst:IsA("ImageLabel") or inst:IsA("ImageButton"))) then return end
    if Nebublox.Assets:ApplyImage(inst, iconName) then return end

    local hubData = ANHub_Icons.Icons[iconName] or ANHub_Icons.Icons[iconName:lower()] or ANHub_Icons.Icons[iconName .. "-stroke"]
    if hubData then
        pcall(function() inst.Image = ANHub_Icons.Spritesheets[hubData.Image] end)
        SetRect(inst, hubData.ImageRectPosition, hubData.ImageRectSize)
        return
    end

    if Icons and Icons.Icon then
        local ok, data = pcall(function() return Icons.Icon(iconName) or Icons.Icon(iconName:lower()) end)
        if ok and data and typeof(data) == "table" then
            pcall(function() inst.Image = data[1] or "" end)
            local rect = data[2]
            if rect then SetRect(inst, rect.ImageRectPosition or Vector2.new(), rect.ImageRectSize or Vector2.new()) end
            return
        elseif ok and typeof(data) == "string" then
            pcall(function() inst.Image = (data:find("rbxassetid://") and data) or "rbxassetid://" .. data end)
            return
        end
    end
end

local function CheckIconType(icon)
    if not icon or icon == "" then return nil end
    local sIcon = tostring(icon)
    if sIcon:find("rbxassetid://") or sIcon:find("rbxthumb://") or tonumber(sIcon) then return "Asset" end
    if sIcon:match("[^%w%s%-_]") then return "Emoji" end
    return "Spritesheet"
end

function Nebublox:GetAsset(id)
    if not id then return "" end
    if type(id) == "string" and (id:find("rbxassetid://") or id:find("http")) then return id end
    return "rbxassetid://" .. tostring(id)
end

local function GetIcon(name)
    if not name or name == "" then return nil end
    local iType = CheckIconType(name)
    if iType == "Asset" then
        if tostring(name):find("rbxthumb://") then return tostring(name) end
        local numId = tostring(name):match("%d+")
        if numId then return "rbxthumb://type=Asset&id=" .. numId .. "&w=420&h=420" end
        return "rbxassetid://" .. tostring(name)
    end
    if iType == "Emoji" then return nil end
    return "rbxassetid://10723415903"
end
Nebublox.GetIcon = GetIcon

-- Tworzy ikone (asset / nazwa lucide / emoji)
local function NewIcon(props, icon)
    props = props or {}
    local t = CheckIconType(icon)
    if t == "Emoji" then
        props.Text = tostring(icon)
        props.BackgroundTransparency = 1
        props.TextScaled = true
        props.Font = Enum.Font.SourceSans
        props.TextColor3 = Color3.new(1, 1, 1)
        local l = Create("TextLabel", props)
        l.Name = "Icon"
        return l
    end
    props.Image = GetIcon(icon) or ""
    if props.BackgroundTransparency == nil then props.BackgroundTransparency = 1 end
    local img = Create("ImageLabel", props)
    if t == "Spritesheet" then ApplyIcon(img, tostring(icon)) end
    return img
end

local function SetIconOn(inst, icon)
    if not inst or not icon then return end
    if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
        if CheckIconType(icon) == "Spritesheet" then
            inst.Image = GetIcon(icon) or ""
            ApplyIcon(inst, tostring(icon))
        else
            inst.Image = GetIcon(icon) or ""
            SetRect(inst, Vector2.new(0, 0), Vector2.new(0, 0))
        end
    elseif inst:IsA("TextLabel") then
        inst.Text = tostring(icon)
    end
end

