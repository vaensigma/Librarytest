function ComponentManager:CreateToggle(data)
    local T = Nebublox.Theme
    local name = data.Name or ""
    local cb = data.Callback or function() end
    local state = data.Default or false
    local scale = data.Scale or 1
    local height = 50 * scale
    local fontSize = 13 * scale

    local tFrame = Create("TextButton", {
        Name = name ~= "" and name or "Toggle", Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = T.SurfaceLight, Active = true,
        BackgroundTransparency = T.GlassTransparency, Text = "", AutoButtonColor = false, Parent = ParentOf(self)
    }, {
        Create("UICorner", {CornerRadius = T.CornerRadius}),
        Create("UIStroke", {Name = "Stroke", Color = T.PrimaryAccent, Thickness = 1, Transparency = 0.3}),
        Create("TextLabel", {
            Name = "TextLabel", Size = UDim2.new(1, -(45 * scale + 15), 1, 0), Position = UDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1, Text = name, Font = T.FontBold, TextSize = fontSize, TextColor3 = T.TextNormal,
            TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, ZIndex = 5
        }),
        Create("Frame", {
            Name = "Track", Size = UDim2.new(0, 42 * scale, 0, 22 * scale), Position = UDim2.new(1, -10, 0.5, 0),
            AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = T.Background, BackgroundTransparency = 0
        }, {
            Create("UICorner", {CornerRadius = UDim.new(1, 0)}),
            Create("UIStroke", {Name = "TrackStroke", Color = T.PrimaryAccent, Thickness = 1, Transparency = 0.5}),
            Create("Frame", {
                Name = "Knob", Size = UDim2.new(0, 16 * scale, 0, 16 * scale), Position = UDim2.new(0, state and (22 * scale) or 3, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = state and T.PrimaryAccent or T.TextMuted, ZIndex = 15, BackgroundTransparency = 0
            }, {
                Create("UICorner", {CornerRadius = UDim.new(1, 0)}),
                Create("UIGradient", {Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(0.7, 0.7, 1))})
            })
        })
    })

    if data.Icon then
        NewIcon({Name = "Icon", Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(0, 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = tFrame}, data.Icon)
        local lbl = tFrame:FindFirstChild("TextLabel")
        if lbl then
            lbl.Position = UDim2.new(0, 34, 0, 0)
            lbl.Size = UDim2.new(1, -(45 * scale + 38), 1, 0)
        end
    end

    local Hitbox = Create("TextButton", {
        Name = "Hitbox", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 100, Active = true, Parent = tFrame
    })
    Hitbox.MouseEnter:Connect(function() Tween(tFrame, {BackgroundColor3 = T.Card, BackgroundTransparency = 0}) end)
    Hitbox.MouseLeave:Connect(function() Tween(tFrame, {BackgroundColor3 = T.SurfaceLight, BackgroundTransparency = T.GlassTransparency}) end)

    local elementData, parentTab = Register(self, name, "Toggle", tFrame, { State = state })

    local function update(silent)
        local stroke = tFrame:FindFirstChild("Stroke")
        local activeColor = data.Color or T.PrimaryAccent
        Tween(tFrame.Track.Knob, {
            Position = UDim2.new(0, state and (22 * scale) or 3, 0.5, 0),
            BackgroundColor3 = state and activeColor or T.TextMuted
        })
        if stroke then Tween(stroke, {Color = state and activeColor or T.SecondaryAccent, Transparency = state and 0 or 0.4}) end
        elementData.State = state
        if parentTab and parentTab.UpdateBadge then parentTab:UpdateBadge() end
        if not silent then Fire(cb, state) end
    end

    local db = false
    Hitbox.MouseButton1Click:Connect(function()
        if db then return end
        db = true
        state = not state
        update()
        task.delay(0.15, function() db = false end)
    end)
    update()

    local obj = { Frame = tFrame, flag = data.Flag }
    function obj:Set(v, silent) state = v and true or false; update(silent) end
    function obj:Get() return state end
    function obj:GetValue() return state end
    function obj:Toggle() state = not state; update() end
    function obj:SetName(n) name = n; elementData.Name = n; local l = tFrame:FindFirstChild("TextLabel"); if l then l.Text = n end end
    function obj:SetIcon(id) SetIconOn(tFrame:FindFirstChild("Icon"), id) end
    function obj:SetColor(col) data.Color = col; update(true) end
    if obj.flag then Nebublox.Flags[obj.flag] = obj end
    return obj
end

function ComponentManager:CreateKeybind(data)
    local T = Nebublox.Theme
    local name = data.Name or "Keybind"
    local cb = data.Callback or function() end
    local currentKey = data.Default or Enum.KeyCode.RightShift
    local binding = false

    local kBtn = Create("TextButton", {
        Name = name, Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = T.SurfaceLight, Active = true,
        BackgroundTransparency = T.GlassTransparency, Text = "", AutoButtonColor = false, Parent = ParentOf(self)
    }, {
        Create("UICorner", {CornerRadius = T.CornerRadius}),
        Create("UIStroke", {Name = "Stroke", Color = T.PrimaryAccent, Thickness = 1, Transparency = 0.3}),
        Create("TextLabel", {
            Name = "TextLabel", Size = UDim2.new(1, -110, 1, 0), Position = UDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1, Text = name, Font = T.FontBold, TextSize = 13, TextColor3 = T.TextNormal,
            TextXAlignment = Enum.TextXAlignment.Left
        }),
        Create("Frame", {
            Name = "KeyBox", Size = UDim2.new(0, 85, 0, 24), Position = UDim2.new(1, -10, 0.5, 0),
            AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = T.Background, BackgroundTransparency = 0
        }, {
            Create("UICorner", {CornerRadius = UDim.new(0, 6)}),
            Create("UIStroke", {Color = T.SecondaryAccent, Thickness = 1.2, Transparency = 0.2}),
            Create("TextLabel", {
                Name = "KeyLabel", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = currentKey.Name,
                Font = T.FontBold, TextSize = 12, TextColor3 = T.SecondaryAccent, TextXAlignment = Enum.TextXAlignment.Center
            })
        })
    })
    Register(self, name, "Keybind", kBtn)

    kBtn.MouseEnter:Connect(function() Tween(kBtn, {BackgroundColor3 = T.Card, BackgroundTransparency = 0}) end)
    kBtn.MouseLeave:Connect(function() Tween(kBtn, {BackgroundColor3 = T.SurfaceLight, BackgroundTransparency = T.GlassTransparency}) end)

    local keyLabel = kBtn.KeyBox.KeyLabel
    local function update()
        keyLabel.Text = binding and "..." or currentKey.Name
        Tween(keyLabel, {TextColor3 = binding and T.PrimaryAccent or T.SecondaryAccent})
    end

    local bindConn
    local function stopBinding()
        binding = false
        genv.Nebublox_Binding = false
        if bindConn then bindConn:Disconnect(); bindConn = nil end
        update()
    end

    kBtn.MouseButton1Click:Connect(function()
        if binding then return end
        binding = true
        genv.Nebublox_Binding = true
        update()
        bindConn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode ~= Enum.KeyCode.Escape then
                    currentKey = input.KeyCode
                    Fire(cb, currentKey)
                end
                task.defer(stopBinding)
            elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                task.defer(stopBinding)
            end
        end)
    end)

    local pressConn
    if data.OnPress then
        pressConn = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe or binding then return end
            if input.KeyCode == currentKey then Fire(data.OnPress) end
        end)
    end

    kBtn.Destroying:Connect(function()
        if bindConn then bindConn:Disconnect() end
        if pressConn then pressConn:Disconnect() end
        genv.Nebublox_Binding = false
    end)

    local obj = { Frame = kBtn, flag = data.Flag }
    function obj:Set(v, silent)
        if typeof(v) == "string" then v = Enum.KeyCode[v] end
        if typeof(v) ~= "EnumItem" then return end
        currentKey = v; update()
        if not silent then Fire(cb, v) end
    end
    function obj:GetValue() return currentKey end
    if obj.flag then Nebublox.Flags[obj.flag] = obj end
    return obj
end

function ComponentManager:AddRow(config)
    local vp = Workspace.CurrentCamera.ViewportSize
    local isMobile = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
    local isSmallScreen = vp.X < 800 or isMobile

    local colConfigs = config.Columns or 1
    local colsDesktop = type(colConfigs) == "table" and #colConfigs or colConfigs

    local cols = colsDesktop
    if isSmallScreen then
        local mobCols = config.MobileColumns or 1
        cols = type(mobCols) == "table" and #mobCols or mobCols
    end

    if cols == 1 and colsDesktop > 1 then
        local columnObjects = {}
        for i = 1, colsDesktop do table.insert(columnObjects, self) end
        return columnObjects
    end

    local rowFrame = Create("Frame", {
        Name = "Row", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        Parent = ParentOf(self), ClipsDescendants = false
    }, {
        Create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Top
        })
    })

    local columnObjects = {}
    local currentConfigs = (isSmallScreen and config.MobileColumns) or config.Columns
    for i = 1, cols do
        local weight = (type(currentConfigs) == "table" and currentConfigs[i]) or (1 / cols)
        local safeOffset = -(((cols - 1) * 8) * weight) - 6
        local col = Create("Frame", {
            Name = "Column_" .. i, Size = UDim2.new(weight, safeOffset, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Parent = rowFrame, ClipsDescendants = false
        }, {
            Create("UIListLayout", {
                Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
                HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Top
            })
        })
        table.insert(columnObjects, setmetatable({Frame = col, Container = col, ParentTab = self.ParentTab or self}, ComponentManager))
    end

    local returned = {}
    local count = 0
    while count < colsDesktop do
        for i = 1, cols do
            count = count + 1
            table.insert(returned, columnObjects[i])
            if count >= colsDesktop then break end
        end
    end
    if #returned == 0 then table.insert(returned, self) end
    return returned
end

function ComponentManager:CreateSlider(data)
    local T = Nebublox.Theme
    local name = data.Name or "Slider"
    local min = data.Min or 0
    local max = data.Max or 100
    local step = data.Step or 1
    local suffix = data.Suffix or ""
    local cb = data.Callback or function() end
    local value = math.clamp(data.Default or min, min, max)
    local range = (max - min) == 0 and 1 or (max - min)

    local sFrame = Create("Frame", {
        Name = name, Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = T.SurfaceLight,
        BackgroundTransparency = T.GlassTransparency, Parent = ParentOf(self)
    }, {
        Create("UICorner", {CornerRadius = T.CornerRadius}),
        Create("UIStroke", {Name = "Stroke", Color = T.PrimaryAccent, Thickness = 1, Transparency = 0.3}),
        Create("TextLabel", {
            Name = "TextLabel", Size = UDim2.new(1, -80, 0, 24), Position = UDim2.new(0, 12, 0, 4), BackgroundTransparency = 1,
            Text = name, Font = T.FontBold, TextSize = 13, TextColor3 = T.TextNormal, TextXAlignment = Enum.TextXAlignment.Left
        }),
        Create("TextBox", {
            Name = "Val", Size = UDim2.new(0, 70, 0, 24), Position = UDim2.new(1, -10, 0, 4), AnchorPoint = Vector2.new(1, 0),
            BackgroundTransparency = 1, Text = "", Font = T.FontBold, TextSize = 13, TextColor3 = T.PrimaryAccent,
            TextXAlignment = Enum.TextXAlignment.Right, ClearTextOnFocus = false
        }),
        Create("Frame", {
            Name = "Track", Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 12, 0, 34),
            BackgroundColor3 = T.Background, BackgroundTransparency = 0
        }, {
            Create("UICorner", {CornerRadius = UDim.new(1, 0)}),
            Create("Frame", {Name = "Fill", Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.PrimaryAccent, BackgroundTransparency = 0}, {
                Create("UICorner", {CornerRadius = UDim.new(1, 0)}),
                Create("UIGradient", {Color = ColorSequence.new(T.SecondaryAccent, T.PrimaryAccent)})
            }),
            Create("Frame", {
                Name = "Knob", Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundColor3 = T.TextHeader, BackgroundTransparency = 0
            }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)}), Create("UIStroke", {Color = T.PrimaryAccent, Thickness = 2, Transparency = 0.45})})
        }),
        -- wiekszy obszar klikniecia nad torem
        Create("Frame", {Name = "Hit", Size = UDim2.new(1, -24, 0, 24), Position = UDim2.new(0, 12, 0, 26), BackgroundTransparency = 1, Active = true, ZIndex = 5})
    })

    local ValBox = sFrame.Val
    local Track = sFrame.Track

    local function snap(v)
        if step > 0 then v = math.floor(v / step + 0.5) * step end
        return tonumber(string.format("%.6f", v))
    end
    local function fmt(v)
        local t = string.format("%.4f", v)
        t = t:gsub("(%..-)0+$", "%1")
        t = t:gsub("%.$", "")
        return t .. suffix
    end
    local function updateUI(v)
        local delta = math.clamp((v - min) / range, 0, 1)
        if not ValBox:IsFocused() then ValBox.Text = fmt(v) end
        Track.Fill.Size = UDim2.new(delta, 0, 1, 0)
        Track.Knob.Position = UDim2.new(delta, 0, 0.5, 0)
    end

    ValBox.Focused:Connect(function() ValBox.Text = tostring(value) end)
    ValBox.FocusLost:Connect(function()
        local parsed = tonumber((ValBox.Text:gsub("[^%d%.%-]", "")))
        if parsed then
            value = snap(math.clamp(parsed, min, max))
            Fire(cb, value)
        end
        updateUI(value)
    end)

    local sliding = false
    local function move(input)
        local delta = math.clamp((input.Position.X - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1), 0, 1)
        local nv = snap(math.clamp(min + (max - min) * delta, min, max))
        if nv ~= value then
            value = nv
            updateUI(value)
            Fire(cb, value)
        end
    end

    sFrame.Hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true; Tween(Track.Knob, {Size = UDim2.new(0, 18, 0, 18)}, 0.12); move(input)
        end
    end)
    local endConn = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then if sliding then sliding = false; Tween(Track.Knob, {Size = UDim2.new(0, 14, 0, 14)}, 0.12) end end
    end)
    local changeConn = UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then move(input) end
    end)
    sFrame.Destroying:Connect(function() endConn:Disconnect(); changeConn:Disconnect() end)

    updateUI(value)
    Register(self, name, "Slider", sFrame)

    local obj = { Frame = sFrame, flag = data.Flag }
    function obj:Set(v, silent)
        value = snap(math.clamp(tonumber(v) or min, min, max)); updateUI(value)
        if not silent then Fire(cb, value) end
    end
    function obj:GetValue() return value end
    if obj.flag then Nebublox.Flags[obj.flag] = obj end
    return obj
end

function ComponentManager:CreateDropdown(data)
    local T = Nebublox.Theme
    local name = data.Name or ""
    local options = data.Options or {}
    local multi = data.Multi and true or false
    local cb = data.Callback or function() end
    local icon = data.Icon
    local iconColor = typeof(data.IconColor) == "Color3" and data.IconColor or T.TextNormal
    local hasTitle = name ~= ""
    local btnH = 40
    local collapsedH = (hasTitle and 18 or 0) + btnH
    local open = false
    local current

    if multi then
        current = {}
        if type(data.Default) == "table" then for _, v in ipairs(data.Default) do table.insert(current, v) end end
    else
        current = data.Default
        if type(current) == "table" and current.Icon and not icon then icon = current.Icon end
    end

    local function optName(o)
        if type(o) == "table" then return tostring(o.Name or o[1] or "?") end
        return tostring(o)
    end
    local function same(a, b)
        if a == b then return true end
        local an = type(a) == "table" and a.Name or a
        local bn = type(b) == "table" and b.Name or b
        return an ~= nil and an == bn
    end
    local function indexOf(list, o)
        for i, x in ipairs(list) do if same(x, o) then return i end end
        return nil
    end
    local function displayText()
        if multi then
            if #current == 0 then return "None" end
            if #current <= 2 then
                local n = {}
                for _, o in ipairs(current) do table.insert(n, optName(o)) end
                return table.concat(n, ", ")
            end
            return #current .. " Selected"
        end
        if current == nil then return "Select..." end
        return optName(current)
    end

    local container = Create("Frame", {
        Name = "DropdownContainer", Size = UDim2.new(1, 0, 0, collapsedH), BackgroundTransparency = 1,
        ClipsDescendants = true, Parent = ParentOf(self)
    }, {
        Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4)})
    })

    if hasTitle then
        Create("TextLabel", {
            Name = "Title", Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 1, BackgroundTransparency = 1, Text = name,
            Font = T.FontBold, TextSize = 12, TextColor3 = T.TextMuted, TextXAlignment = Enum.TextXAlignment.Left, Parent = container
        })
    end

    local dBtn = Create("TextButton", {
        Name = "Button", Size = UDim2.new(1, 0, 0, btnH), LayoutOrder = 2, BackgroundColor3 = T.SurfaceLight,
        BackgroundTransparency = T.GlassTransparency, Text = "", AutoButtonColor = false, Parent = container
    }, {
        Create("UICorner", {CornerRadius = T.CornerRadius}),
        Create("UIStroke", {Name = "Stroke", Color = T.PrimaryAccent, Thickness = 1, Transparency = 0.3}),
    })
    local iconLabel
    if icon then
        iconLabel = NewIcon({Name = "Icon", Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(0, 12, 0.5, -9), ImageColor3 = iconColor, Parent = dBtn}, icon)
    end
    local valueLabel = Create("TextLabel", {
        Name = "TextLabel", Size = UDim2.new(1, icon and -55 or -30, 1, 0), Position = UDim2.new(0, icon and 36 or 12, 0, 0),
        BackgroundTransparency = 1, Text = "", Font = T.FontBold, TextSize = 13, TextColor3 = T.TextNormal,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = dBtn
    })
    local arrow = Create("TextLabel", {
        Name = "Arrow", Size = UDim2.new(0, 20, 1, 0), Position = UDim2.new(1, -10, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
        BackgroundTransparency = 1, Text = "v", Font = T.FontBold, TextSize = 14, TextColor3 = T.TextMuted, Parent = dBtn
    })

    local function setDisplay()
        valueLabel.Text = "<font color='#" .. Nebublox.Theme.PrimaryAccent:ToHex() .. "'>" .. displayText() .. "</font>"
    end
    setDisplay()

    Hover(dBtn, dBtn, {BackgroundColor3 = T.Card, BackgroundTransparency = 0}, {BackgroundColor3 = T.SurfaceLight, BackgroundTransparency = T.GlassTransparency})

    local optFrame = Create("ScrollingFrame", {
        Name = "Options", Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 3, BackgroundColor3 = T.Surface, BackgroundTransparency = 0.05,
        ClipsDescendants = true, Visible = false, ScrollBarThickness = 4, ScrollBarImageColor3 = T.PrimaryAccent,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0, 0, 0, 0), BorderSizePixel = 0,
        ScrollingDirection = Enum.ScrollingDirection.Y, ElasticBehavior = Enum.ElasticBehavior.Never, Active = true, Parent = container
    }, {
        Create("UICorner", {CornerRadius = T.CornerRadius}),
        Create("UIStroke", {Color = T.PrimaryAccent, Thickness = 1, Transparency = 0.4}),
        Create("UIPadding", {PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2)}),
        Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)})
    })

    local function listHeight() return math.min(#options * 30 + 4, 180) end
    local function resize()
        optFrame.Size = UDim2.new(1, 0, 0, listHeight())
        Tween(container, {Size = UDim2.new(1, 0, 0, collapsedH + (open and (4 + listHeight()) or 0))}, 0.18)
    end

    local closeDropdown
    local function refresh()
        for _, child in ipairs(optFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for i, opt in ipairs(options) do
            local isSelected = multi and indexOf(current, opt) ~= nil or (not multi and current ~= nil and same(current, opt))
            local oIcon = type(opt) == "table" and opt.Icon or nil
            local oIcon2 = type(opt) == "table" and opt.SecondaryIcon or nil
            local textOffset = (oIcon and 30 or 10) + (oIcon2 and 20 or 0)
            local oBtn = Create("TextButton", {
                Name = "Opt_" .. i, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = i, BackgroundTransparency = isSelected and 0.8 or 1,
                BackgroundColor3 = T.PrimaryAccent, Text = "", AutoButtonColor = false, Parent = optFrame
            }, {
                Create("UICorner", {CornerRadius = UDim.new(0, 6)}),
                Create("TextLabel", {
                    Size = UDim2.new(1, -textOffset - 4, 1, 0), Position = UDim2.new(0, textOffset, 0, 0), BackgroundTransparency = 1,
                    Text = optName(opt), Font = isSelected and T.FontBold or T.FontBase, TextSize = 12,
                    TextColor3 = isSelected and T.PrimaryAccent or T.TextNormal, TextXAlignment = Enum.TextXAlignment.Left
                })
            })
            if oIcon then NewIcon({Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = oBtn}, oIcon) end
            if oIcon2 then NewIcon({Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, oIcon and 28 or 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = oBtn}, oIcon2) end
            if not isSelected then
                oBtn.MouseEnter:Connect(function() Tween(oBtn, {BackgroundTransparency = 0.9}, 0.1) end)
                oBtn.MouseLeave:Connect(function() Tween(oBtn, {BackgroundTransparency = 1}, 0.1) end)
            end
            oBtn.MouseButton1Click:Connect(function()
                if multi then
                    local idx = indexOf(current, opt)
                    if idx then table.remove(current, idx) else table.insert(current, opt) end
                    setDisplay(); refresh(); Fire(cb, copyList(current))
                else
                    current = opt
                    setDisplay()
                    if iconLabel and type(opt) == "table" and opt.Icon then SetIconOn(iconLabel, opt.Icon) end
                    closeDropdown()
                    Fire(cb, opt)
                end
            end)
        end
    end

    closeDropdown = function()
        open = false
        optFrame.Visible = false
        arrow.Text = "v"
        resize()
    end

    dBtn.MouseButton1Click:Connect(function()
        open = not open
        arrow.Text = open and "^" or "v"
        if open then refresh() end
        optFrame.Visible = open
        resize()
    end)

    Register(self, name, "Dropdown", container)

    local obj = { Frame = container, flag = data.Flag }
    function obj:Refresh(newList, keepVal)
        options = newList or {}
        if not keepVal then
            if multi then
                local kept = {}
                for _, o in ipairs(current) do if indexOf(options, o) then table.insert(kept, o) end end
                current = kept
            elseif current == nil or not indexOf(options, current) then
                current = options[1]
            end
        end
        setDisplay()
        if open then refresh(); resize() end
    end
    function obj:UpdateOptions(newList, keepVal) self:Refresh(newList, keepVal) end
    function obj:SetOptions(newList, keepVal) self:Refresh(newList, keepVal) end
    function obj:Set(v, silent)
        if multi then
            local new = {}
            local src = type(v) == "table" and v or {v}
            for _, x in ipairs(src) do
                for _, o in ipairs(options) do
                    if same(o, x) then table.insert(new, o); break end
                end
            end
            current = new
        else
            local found = nil
            for _, o in ipairs(options) do
                if same(o, v) then found = o; break end
            end
            current = found ~= nil and found or v
        end
        setDisplay()
        if open then refresh() end
        if not silent then Fire(cb, multi and copyList(current) or current) end
    end
    function obj:GetValue() return multi and copyList(current) or current end
    function obj:Close() if open then closeDropdown() end end
    if obj.flag then Nebublox.Flags[obj.flag] = obj end
    return obj
end

function ComponentManager:CreateColorPicker(data)
    local T = Nebublox.Theme
    local name = data.Name or "Color"
    local cb = data.Callback or function() end
    local color = ParseColor(data.Default) or Color3.fromRGB(255, 255, 255)
    local h, s, v = color:ToHSV()
    local collapsedH, panelH = 44, 140
    local open = false

    local container = Create("Frame", {
        Name = name, Size = UDim2.new(1, 0, 0, collapsedH), BackgroundColor3 = T.SurfaceLight,
        BackgroundTransparency = T.GlassTransparency, ClipsDescendants = true, Parent = ParentOf(self)
    }, {
        Create("UICorner", {CornerRadius = T.CornerRadius}),
        Create("UIStroke", {Color = T.PrimaryAccent, Thickness = 1, Transparency = 0.3}),
    })

    local header = Create("TextButton", {
        Name = "Header", Size = UDim2.new(1, 0, 0, collapsedH), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = container
    }, {
        Create("TextLabel", {
            Size = UDim2.new(1, -120, 1, 0), Position = UDim2.new(0, 12, 0, 0), BackgroundTransparency = 1, Text = name,
            Font = T.FontBold, TextSize = 13, TextColor3 = T.TextNormal, TextXAlignment = Enum.TextXAlignment.Left
        })
    })
    local hexLabel = Create("TextLabel", {
        Size = UDim2.new(0, 64, 0, 20), Position = UDim2.new(1, -44, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1,
        Text = "", Font = T.FontBold, TextSize = 11, TextColor3 = T.TextDim, TextXAlignment = Enum.TextXAlignment.Right, Parent = header
    })
    local swatch = Create("Frame", {
        Size = UDim2.new(0, 28, 0, 22), Position = UDim2.new(1, -10, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = color, Parent = header
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0, 6)}),
        Create("UIStroke", {Color = Color3.new(1, 1, 1), Thickness = 1, Transparency = 0.5})
    })

    local panel = Create("Frame", {
        Name = "Panel", Size = UDim2.new(1, -20, 0, panelH), Position = UDim2.new(0, 10, 0, collapsedH), BackgroundTransparency = 1, Parent = container
    })
    local svCursor = Create("Frame", {
        Name = "Cursor", Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 5
    }, {
        Create("UICorner", {CornerRadius = UDim.new(1, 0)}),
        Create("UIStroke", {Color = Color3.new(1, 1, 1), Thickness = 2})
    })
    local sv = Create("Frame", {
        Name = "SV", Size = UDim2.new(1, 0, 0, 110), BackgroundColor3 = Color3.fromHSV(h, 1, 1), BorderSizePixel = 0, Active = true, Parent = panel
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0, 6)}),
        Create("Frame", {Name = "White", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, {
            Create("UICorner", {CornerRadius = UDim.new(0, 6)}),
            Create("UIGradient", {Transparency = NumberSequence.new(0, 1)})
        }),
        Create("Frame", {Name = "Black", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0}, {
            Create("UICorner", {CornerRadius = UDim.new(0, 6)}),
            Create("UIGradient", {Rotation = 90, Transparency = NumberSequence.new(1, 0)})
        }),
        svCursor
    })
    local hueCursor = Create("Frame", {
        Name = "Cursor", Size = UDim2.new(0, 6, 1, 6), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 5
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0, 3)}),
        Create("UIStroke", {Color = Color3.new(0, 0, 0), Thickness = 1})
    })
    local hue = Create("Frame", {
        Name = "Hue", Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0, 120), BackgroundColor3 = Color3.new(1, 1, 1), Active = true, Parent = panel
    }, {
        Create("UICorner", {CornerRadius = UDim.new(0, 7)}),
        Create("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
            })
        }),
        hueCursor
    })

    local function apply(fire)
        color = Color3.fromHSV(h, s, v)
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
        hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
        swatch.BackgroundColor3 = color
        hexLabel.Text = "#" .. color:ToHex():upper()
        if fire then Fire(cb, color) end
    end
    apply(false)

    local mode = nil
    local function upd(input)
        if mode == "sv" then
            local p, sz = sv.AbsolutePosition, sv.AbsoluteSize
            s = math.clamp((input.Position.X - p.X) / math.max(sz.X, 1), 0, 1)
            v = 1 - math.clamp((input.Position.Y - p.Y) / math.max(sz.Y, 1), 0, 1)
        elseif mode == "hue" then
            h = math.clamp((input.Position.X - hue.AbsolutePosition.X) / math.max(hue.AbsoluteSize.X, 1), 0, 0.999)
        else
            return
        end
        apply(true)
    end
    local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
    sv.InputBegan:Connect(function(i) if isPress(i) then mode = "sv"; upd(i) end end)
    hue.InputBegan:Connect(function(i) if isPress(i) then mode = "hue"; upd(i) end end)
    local c1 = UserInputService.InputChanged:Connect(function(i)
        if mode and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i) end
    end)
    local c2 = UserInputService.InputEnded:Connect(function(i) if isPress(i) then mode = nil end end)
    container.Destroying:Connect(function() c1:Disconnect(); c2:Disconnect() end)

    header.MouseButton1Click:Connect(function()
        open = not open
        Tween(container, {Size = UDim2.new(1, 0, 0, open and (collapsedH + panelH + 8) or collapsedH)}, 0.2)
    end)

    Register(self, name, "ColorPicker", container)

    local obj = { Frame = container, flag = data.Flag }
    function obj:Set(c, silent)
        local parsed = ParseColor(c)
        if not parsed then return end
        h, s, v = parsed:ToHSV()
        apply(not silent)
    end
    function obj:Get() return color end
    function obj:GetValue() return color end
    if obj.flag then Nebublox.Flags[obj.flag] = obj end
    return obj
end

function ComponentManager:CreateTextbox(data)
    local T = Nebublox.Theme
    local name = data.Name or "Textbox"
    local placeholder = data.Placeholder or "Enter text..."
    local cb = data.Callback or function() end

    local tFrame = Create("Frame", {
        Name = name, Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.SurfaceLight,
        BackgroundTransparency = T.GlassTransparency, Parent = ParentOf(self)
    }, {
        Create("UICorner", {CornerRadius = T.CornerRadius}),
        Create("UIStroke", {Name = "Stroke", Color = T.PrimaryAccent, Thickness = 1, Transparency = 0.3}),
        Create("TextBox", {
            Size = UDim2.new(1, -24, 1, 0), Position = UDim2.new(0, 12, 0, 0), BackgroundTransparency = 1, Font = T.FontBold, TextSize = 13,
            TextColor3 = T.TextNormal, Text = data.Default or "", PlaceholderText = placeholder, PlaceholderColor3 = T.TextMuted,
            TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, TextTruncate = Enum.TextTruncate.AtEnd
        })
    })
    local textbox = tFrame:FindFirstChildOfClass("TextBox")
    local stroke = tFrame:FindFirstChild("Stroke")
    textbox.Focused:Connect(function() if stroke then Tween(stroke, {Transparency = 0, Thickness = 1.6}) end end)
    textbox.FocusLost:Connect(function(ep)
        if stroke then Tween(stroke, {Transparency = 0.3, Thickness = 1}) end
        Fire(cb, textbox.Text, ep)
    end)

    Register(self, name, "Textbox", tFrame)

    local obj = { Frame = tFrame, flag = data.Flag }
    function obj:Set(val, silent) textbox.Text = tostring(val); if not silent then Fire(cb, textbox.Text, true) end end
    function obj:GetValue() return textbox.Text end
    if obj.flag then Nebublox.Flags[obj.flag] = obj end
    return obj
end

function ComponentManager:CreateParagraph(data)
    local T = Nebublox.Theme
    local title = data.Title
    local content = data.Content or ""
    local center = data.Center or false
    local xAlign = center and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left

    local pFrame = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = ParentOf(self)
    }, {Create("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder})})

    local TitleLabel
    if title and title ~= "" then
        if data.Icon then
            local titleFrame = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Parent = pFrame
            }, {
                Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Center}),
            })
            NewIcon({Name = "Icon", Size = UDim2.new(0, 18, 0, 18), ImageColor3 = T.TextNormal, LayoutOrder = 1, Parent = titleFrame}, data.Icon)
            TitleLabel = Create("TextLabel", {
                Name = "Label", Size = UDim2.new(1, -24, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = title, LayoutOrder = 2,
                Font = T.FontBold, TextSize = 15, TextColor3 = T.PrimaryAccent, TextWrapped = true, TextXAlignment = xAlign, Parent = titleFrame
            })
        else
            TitleLabel = Create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = title, LayoutOrder = 1,
                Font = T.FontBold, TextSize = 15, TextColor3 = T.PrimaryAccent, TextWrapped = true, TextXAlignment = xAlign, Parent = pFrame
            })
        end
        if data.Gradient then ApplyTextGradient(TitleLabel, data.Gradient) end
    end

    local ContentLabel = Create(data.Copyable and "TextBox" or "TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = content, LayoutOrder = 2,
        Font = T.FontBody, TextSize = 13, TextColor3 = T.TextNormal, TextWrapped = true, TextXAlignment = xAlign, TextYAlignment = Enum.TextYAlignment.Top,
        Parent = pFrame
    })
    if data.Copyable then
        ContentLabel.TextEditable = false; ContentLabel.ClearTextOnFocus = false; ContentLabel.MultiLine = true
    end

    local obj = setmetatable({Frame = pFrame, Container = pFrame, ContentLabel = ContentLabel, TitleLabel = TitleLabel, Copyable = data.Copyable}, ComponentManager)
    function obj:SetContent(text) ContentLabel.Text = text end
    function obj:SetTitle(text) if TitleLabel then TitleLabel.Text = text end end
    function obj:SetText(newTitle, newContent)
        if type(newTitle) == "string" and TitleLabel then TitleLabel.Text = newTitle end
        if type(newContent) == "string" then ContentLabel.Text = newContent end
    end
    function obj:Update(nT, nC) self:SetText(nT, nC) end
    return obj
end

function ComponentManager:CreateSection(config)
    local T = Nebublox.Theme
    local sectionColor = config.Color
    if type(sectionColor) == "string" then
        if sectionColor:sub(1, 1) == "#" then
            sectionColor = ParseColor(sectionColor)
        elseif sectionColor:match("[%d%.]+%s[%d%.]+") then
            sectionColor = StringToColorSequence(sectionColor)
        end
    end
    local strokeColor = T.SecondaryAccent
    local textColor = T.PrimaryAccent
    if typeof(sectionColor) == "Color3" then
        strokeColor = sectionColor; textColor = sectionColor
    elseif typeof(sectionColor) == "ColorSequence" then
        strokeColor = sectionColor.Keypoints[1].Value
    end

    local SectionFrame = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Surface,
        BackgroundTransparency = T.GlassTransparency, Parent = ParentOf(self)
    }, {
        Create("UICorner", {CornerRadius = T.CornerRadius}),
        Create("UIStroke", {Name = "SectionStroke", Color = strokeColor, Thickness = 1.2, Transparency = 0.2}),
        Create("UIGradient", {Color = ColorSequence.new(T.SurfaceLight, T.Surface), Rotation = 90}),
        Create("UIPadding", {PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)}),
        Create("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder})
    })

    if (config.Name and config.Name ~= "") or config.Icon then
        local titleFrame = Create("Frame", {Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Parent = SectionFrame, LayoutOrder = -10})
        Create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Center, Parent = titleFrame
        })
        if config.Icon and config.Icon ~= "" then
            NewIcon({Size = UDim2.new(0, 16, 0, 16), ImageColor3 = textColor, LayoutOrder = 1, Parent = titleFrame}, config.Icon)
        end
        if config.Name and config.Name ~= "" then
            local title = Create("TextLabel", {
                Size = UDim2.new(1, (config.Icon and -22 or 0), 1, 0), BackgroundTransparency = 1, Text = config.Name,
                Font = T.FontBold, TextSize = 13, TextColor3 = textColor, LayoutOrder = 2, Parent = titleFrame,
                TextXAlignment = config.Center and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
            })
            if sectionColor then ApplyTextGradient(title, sectionColor) else ApplyTextGradient(title, "Holographic") end
        end
    end

    if config.Name and config.Name ~= "" then
        Create("Frame", {
            Name = "TitleLine", Size = UDim2.new(1, 0, 0, 1), LayoutOrder = -9, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = SectionFrame
        }, {
            Create("UIGradient", {
                Color = ColorSequence.new(T.PrimaryAccent, T.SecondaryAccent),
                Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1)})
            })
        })
    end

    return setmetatable({Frame = SectionFrame, Container = SectionFrame, ParentTab = self.ParentTab or self}, ComponentManager)
end

