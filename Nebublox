    PlaceholderText = "default",
    Flag = "cfgName",
    Callback = function() end,
})
settings:CreateButton({
    Name = "💾 Save Config",
    Callback = function()
        local name = (Nebublox.Flags.cfgName and Nebublox.Flags.cfgName.Get()) or "default"
        local ok = Nebublox:SaveConfig(name)
        Nebublox:Notify({ Title = "Configs", Content = ok and ("Saved: " .. name) or "Failed", Type = ok and "success" or "error" })
    end,
})
settings:CreateButton({
    Name = "📂 Load Config",
    Callback = function()
        local name = (Nebublox.Flags.cfgName and Nebublox.Flags.cfgName.Get()) or "default"
        local ok = Nebublox:LoadConfig(name)
        Nebublox:Notify({ Title = "Configs", Content = ok and ("Loaded: " .. name) or "Not found", Type = ok and "success" or "error" })
    end,
})
settings:CreateSection("⚙️ System")
settings:CreateButton({
    Name = "🔄 Server Hop",
    Callback = function()
        Nebublox:Notify({ Title = "Server", Content = "Hopping...", Type = "info" })
        Nebublox:ServerHop()
    end,
})
settings:CreateButton({
    Name = "🚪 Unload Nebublox",
    Callback = function()
        if SetAutoBreaking then
            pcall(function() SetAutoBreaking:FireServer(false) end)
        end
        Nebublox:Destroy()
    end,
})

