    -- ============ BUTTON ============
    function win:CreateButton(tab, data)
        data = data or {}
        local name = data.Name or "Button"
        local btn = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 42),
            BackgroundColor3 = T.SurfaceLight,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = NextOrder(tab),
            Parent = GetHolder(tab),
        })
        Round(btn, 8)
        Stroke(btn, T.Accent2, 1, 0.6)
        Create("TextLabel", {
            Size = UDim2.new(1, -20, 1, 0),
            Position = UDim2.new(0, 10, 0, 0),
            BackgroundTransparency = 1,
            Text = name,
            Font = T.FontBold,
            TextSize = 13,
            TextColor3 = T.Text,
            Parent = btn,
        })
        btn.MouseEnter:Connect(function() Tween(btn, { BackgroundColor3 = T.Card }, 0.15) end)
        btn.MouseLeave:Connect(function() Tween(btn, { BackgroundColor3 = T.SurfaceLight }, 0.15) end)
        btn.MouseButton1Click:Connect(function()
            Tween(btn, { BackgroundColor3 = T.Accent2 }, 0.08)
            task.delay(0.1, function() Tween(btn, { BackgroundColor3 = T.SurfaceLight }, 0.2) end)
            Fire(data.Callback)
        end)
        return btn
    end

    -- ============ TOGGLE ============
    function win:CreateToggle(tab, data)
        data = data or {}
        local name = data.Name or "Toggle"
        local currentValue = data.CurrentValue or false
        local flag = data.Flag

        local row = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 40),
            BackgroundColor3 = T.Surface,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = NextOrder(tab),
            Parent = GetHolder(tab),
        })
        Round(row, 8)
        Create("TextLabel", {
            Size = UDim2.new(1, -70, 1, 0),
            Position = UDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1,
            Text = name,
            Font = T.Font,
            TextSize = 13,
            TextColor3 = T.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = row,
        })
        -- switch
        local switch = Create("Frame", {
            Size = UDim2.new(0, 42, 0, 22),
            Position = UDim2.new(1, -12, 0.5, 0),
            AnchorPoint = Vector2.new(1, 0.5),
            BackgroundColor3 = T.SurfaceLight,
            BorderSizePixel = 0,
            Parent = row,
        })
        Round(switch, 11)
        local switchStroke = Stroke(switch, T.Stroke, 1, 0.3)
        local knob = Create("Frame", {
            Size = UDim2.new(0, 16, 0, 16),
            Position = UDim2.new(0, 3, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = T.TextDim,
            BorderSizePixel = 0,
            Parent = switch,
        })
        Round(knob, 8)

        local el = { Type = "Toggle" }
        local function render(v, silent)
            currentValue = v
            if v then
                Tween(switch, { BackgroundColor3 = T.Accent2 }, 0.2)
                Tween(knob, { Position = UDim2.new(1, -19, 0.5, 0), BackgroundColor3 = T.Text }, 0.2)
                switchStroke.Color = T.Accent
            else
                Tween(switch, { BackgroundColor3 = T.SurfaceLight }, 0.2)
                Tween(knob, { Position = UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = T.TextDim }, 0.2)
                switchStroke.Color = T.Stroke
            end
            if not silent then Fire(data.Callback, v) end
        end

        function el.Set(_, v, silent) render(v == true, silent) end
        function el.Get() return currentValue end
        if flag then Nebublox.Flags[flag] = el end

        row.MouseButton1Click:Connect(function()
            render(not currentValue)
        end)
        render(currentValue, true)
        return el
    end

    -- ============ SLIDER ============
    function win:CreateSlider(tab, data)
        data = data or {}
        local name = data.Name or "Slider"
        local min = data.Min or data.Range and data.Range[1] or 0
        local max = data.Max or data.Range and data.Range[2] or 100
        local increment = data.Increment or 1
        local suffix = data.Suffix or ""
        local flag = data.Flag
        local currentValue = data.CurrentValue or min

        local holder = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 56),
            BackgroundColor3 = T.Surface,
            LayoutOrder = NextOrder(tab),
            Parent = GetHolder(tab),
        })
        Round(holder, 8)
        Create("TextLabel", {
            Size = UDim2.new(1, -90, 0, 16),
            Position = UDim2.new(0, 12, 0, 8),
            BackgroundTransparency = 1,
            Text = name,
            Font = T.Font,
            TextSize = 13,
            TextColor3 = T.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = holder,
        })
        local valueLabel = Create("TextLabel", {
            Size = UDim2.new(0, 76, 0, 16),
            Position = UDim2.new(1, -12, 0, 8),
            AnchorPoint = Vector2.new(1, 0),
            BackgroundTransparency = 1,
            Text = tostring(currentValue) .. suffix,
            Font = T.FontBold,
            TextSize = 12,
            TextColor3 = T.Accent,
            TextXAlignment = Enum.TextXAlignment.Right,
            Parent = holder,
        })
        local track = Create("Frame", {
            Size = UDim2.new(1, -24, 0, 6),
            Position = UDim2.new(0, 12, 0, 38),
            BackgroundColor3 = T.Sidebar,
            BorderSizePixel = 0,
            Parent = holder,
        })
        Round(track, 3)
        local fill = Create("Frame", {
            Size = UDim2.new(0, 0, 1, 0),
            BackgroundColor3 = T.Accent,
            BorderSizePixel = 0,
            Parent = track,
        })
        Round(fill, 3)
        local knob = Create("Frame", {
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(0, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = T.Text,
            BorderSizePixel = 0,
            Parent = track,
        })
        Round(knob, 7)

        local el = { Type = "Slider" }
        local function render(v, silent)
            v = math.clamp(v, min, max)
            v = math.floor(v / increment + 0.5) * increment
            currentValue = v
            local rel = (max - min) == 0 and 0 or (v - min) / (max - min)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, 0, 0.5, 0)
            valueLabel.Text = tostring(v) .. suffix
            if not silent then Fire(data.Callback, v) end
        end

        function el.Set(_, v, silent) render(tonumber(v) or min, silent) end
        function el.Get() return currentValue end
        if flag then Nebublox.Flags[flag] = el end

        local dragging = false
        local function fromX(x)
            local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            render(min + (max - min) * rel)
        end
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                fromX(input.Position.X)
            end
        end)
        Track(UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                fromX(input.Position.X)
            end
        end))
        Track(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))
        render(currentValue, true)
        return el
    end

    -- ============ DROPDOWN ============
    function win:CreateDropdown(tab, data)
        data = data or {}
        local name = data.Name or "Dropdown"
        local options = data.Options or {}
        local flag = data.Flag
        local callback = data.Callback
        local current = data.CurrentOption or (options[1] ~= nil and options[1] or nil)

        local holder = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = T.Surface,
            ClipsDescendants = true,
            LayoutOrder = NextOrder(tab),
            Parent = GetHolder(tab),
        })
        Round(holder, 8)
        local listLayout = Create("UIListLayout", {
            Padding = UDim.new(0, 2),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = holder,
        })
        local btn = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 40),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = 1,
            Parent = holder,
        })
        Create("TextLabel", {
            Size = UDim2.new(1, -70, 0, 16),
            Position = UDim2.new(0, 12, 0, 5),
            BackgroundTransparency = 1,
            Text = name,
            Font = T.Font,
            TextSize = 12,
            TextColor3 = T.TextDim,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = btn,
        })
        local valueLabel = Create("TextLabel", {
            Size = UDim2.new(1, -40, 0, 14),
            Position = UDim2.new(0, 12, 0, 21),
            BackgroundTransparency = 1,
            Text = current and tostring(current) or "—",
            Font = T.FontBold,
            TextSize = 13,
            TextColor3 = T.Accent,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = btn,
        })
        local arrow = Create("TextLabel", {
            Size = UDim2.new(0, 20, 1, 0),
            Position = UDim2.new(1, -26, 0, 0),
            BackgroundTransparency = 1,
            Text = "▾",
            TextSize = 14,
            TextColor3 = T.TextDim,
            Parent = btn,
        })
        local optionsHolder = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Visible = false,
            LayoutOrder = 2,
            Parent = holder,
        })
        Create("UIListLayout", { Padding = UDim.new(0, 2), Parent = optionsHolder })

        local el = { Type = "Dropdown" }
        local open = false
        local optionButtons = {}

        local function setOpen(v)
            open = v
            optionsHolder.Visible = v
            arrow.Text = v and "▴" or "▾"
            Tween(holder, { BackgroundColor3 = v and T.SurfaceLight or T.Surface }, 0.15)
        end

        local function select(opt, silent)
            current = opt
            valueLabel.Text = opt and tostring(opt) or "—"
            for o, lbl in pairs(optionButtons) do
                lbl.TextColor3 = (o == opt) and T.Accent or T.TextDim
            end
            if not silent then Fire(callback, opt) end
        end

        function el.Set(_, v, silent)
            if v ~= nil then select(v, silent) end
        end
        function el.Get() return current end
        function el.Refresh(newOptions)
            options = newOptions or {}
            for _, b in pairs(optionButtons) do
                pcall(function() b.Parent:Destroy() end)
            end
            optionButtons = {}
            for _, opt in ipairs(options) do
                local obtn = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 28),
                    BackgroundColor3 = T.Sidebar,
                    Text = "",
                    AutoButtonColor = false,
                    Parent = optionsHolder,
                })
                Round(obtn, 6)
                local olbl = Create("TextLabel", {
                    Size = UDim2.new(1, -20, 1, 0),
                    Position = UDim2.new(0, 10, 0, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(opt),
                    Font = T.Font,
                    TextSize = 12,
                    TextColor3 = (opt == current) and T.Accent or T.TextDim,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    Parent = obtn,
                })
                optionButtons[opt] = olbl
                obtn.MouseButton1Click:Connect(function()
                    select(opt)
                    setOpen(false)
                end)
            end
        end

        if flag then Nebublox.Flags[flag] = el end
        btn.MouseButton1Click:Connect(function() setOpen(not open) end)
        el.Refresh(options)
        if current then select(current, true) end
        return el
    end

    -- ============ TEXTBOX ============
    function win:CreateTextBox(tab, data)
        data = data or {}
        local name = data.Name or "Input"
        local flag = data.Flag

        local holder = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 66),
            BackgroundColor3 = T.Surface,
            LayoutOrder = NextOrder(tab),
            Parent = GetHolder(tab),
        })
        Round(holder, 8)
        Create("TextLabel", {
            Size = UDim2.new(1, -24, 0, 14),
            Position = UDim2.new(0, 12, 0, 8),
            BackgroundTransparency = 1,
            Text = name,
            Font = T.Font,
            TextSize = 12,
            TextColor3 = T.TextDim,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = holder,
        })
        local box = Create("TextBox", {
            Size = UDim2.new(1, -24, 0, 32),
            Position = UDim2.new(0, 12, 0, 26),
            BackgroundColor3 = T.Sidebar,
            Text = data.Text or "",
            PlaceholderText = data.PlaceholderText or "Type here...",
            PlaceholderColor3 = T.TextDim,
            TextColor3 = T.Text,
            Font = T.Font,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false,
            ClipsDescendants = true,
            Parent = holder,
        })
        Round(box, 6)
        Stroke(box, T.Stroke, 1, 0.5)

        local el = { Type = "TextBox" }
        function el.Set(_, v, silent)
            box.Text = tostring(v or "")
            if not silent then Fire(data.Callback, box.Text) end
        end
        function el.Get() return box.Text end
        if flag then Nebublox.Flags[flag] = el end
