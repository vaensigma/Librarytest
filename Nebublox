        Font = T.FontBold,
        TextSize = 11,
        TextColor3 = T.Accent,
        Parent = row,
    })
    Round(chip, 6)
    Stroke(chip, T.Stroke, 1, 0.5)

    local listening = false
    row.MouseButton1Click:Connect(function()
        listening = true
        chip.Text = "Press..."
        chip.TextColor3 = T.Warning
    end)
    Track(UserInputService.InputBegan:Connect(function(input, gpe)
        if not listening or gpe then return end
        if input.KeyCode == Enum.KeyCode.Unknown then return end
        listening = false
        currentBind = input.KeyCode
        chip.Text = currentBind.Name
        chip.TextColor3 = T.Accent
        Fire(data.Callback, currentBind)
    end))

    local el = { Type = "Keybind" }
    el.Get = function() return currentBind end
    el.Set = function(_, k) currentBind = k end
    if data.Flag then Nebublox.Flags[data.Flag] = el end
    return el
end

