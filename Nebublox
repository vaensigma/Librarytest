    function WindowObj:AddConsole(targetTab)
        local ConsoleTab = targetTab or self:AddTab({Name = "Console", Icon = "rbxassetid://109771000357358"})
        local LogSec = ConsoleTab:AddSection({Name = " [ SYSTEM TERMINAL ]"})
        local LogContainer = LogSec:AddParagraph({Title = "", Content = "Initializing kernel terminal...", Center = false, Copyable = true})

        local logs = {}
        local LogService = game:GetService("LogService")
        local function esc(s)
            s = tostring(s)
            s = s:gsub("&", "&amp;")
            s = s:gsub("<", "&lt;")
            s = s:gsub(">", "&gt;")
            return s
        end
        local function updateLogs()
            local parts = {}
            for i = #logs, 1, -1 do
                local log = logs[i]
                local color = "#FFFFFF"
                if log.type == Enum.MessageType.MessageWarning then color = "#FFB800"
                elseif log.type == Enum.MessageType.MessageError then color = "#FF3131"
                elseif log.type == Enum.MessageType.MessageInfo then color = "#00FFFF" end
                table.insert(parts, "<font face='RobotoMono' size='12' color='" .. color .. "'>[" .. log.time .. "] " .. esc(log.msg) .. "</font>")
            end
            LogContainer:SetContent(table.concat(parts, "\n"))
        end
        local pending = false
        local function schedule()
            if pending then return end
            pending = true
            task.delay(0.3, function() pending = false; updateLogs() end)
        end

        local BtnRow = LogSec:AddRow({Columns = 2})
        BtnRow[1]:AddButton({Name = "Copy Logs", Icon = "rbxassetid://10723422036", Callback = function()
            local lines = {}
            for i = #logs, 1, -1 do table.insert(lines, "[" .. logs[i].time .. "] " .. logs[i].msg) end
            setclipboard(table.concat(lines, "\n"))
            self:Notify({Title = "Terminal", Content = "Logs copied to clipboard!", Type = "success"})
        end})
        BtnRow[2]:AddButton({Name = "Clear Logs", Icon = "rbxassetid://10723396652", Callback = function()
            table.clear(logs)
            LogContainer:SetContent("Terminal cleared.")
            self:Notify({Title = "Terminal", Content = "Logs cleared!", Type = "success"})
        end})

        local conn = LogService.MessageOut:Connect(function(msg, msgType)
            if #logs > 50 then table.remove(logs, 1) end
            table.insert(logs, {msg = msg, type = msgType, time = os.date("%H:%M:%S")})
            schedule()
        end)
        self:OnCleanup(function() conn:Disconnect() end)
        return ConsoleTab
    end

    function WindowObj:Destroy()
        if self._destroyed then return end
        self._destroyed = true
        pcall(function()
            local size = Minimized and OrigSize or MainFrame.Size
            genv.Nebublox_SavedSize = size
            genv.Nebublox_SavedPosition = Minimized and OrigPos or MainFrame.Position
        end)
        for _, fn in ipairs(cleanups) do pcall(fn) end
        if self.OnDestroy then pcall(self.OnDestroy) end
        if self.State then pcall(function() self.State.Nebublox_Running = false end) end
        for i = #Nebublox.Windows, 1, -1 do
            if Nebublox.Windows[i] == self then table.remove(Nebublox.Windows, i); break end
        end
        for i = #Nebublox.ActiveInstances, 1, -1 do
            local inst = Nebublox.ActiveInstances[i]
            if inst == ScreenGui or inst == OpenBtnContainer then table.remove(Nebublox.ActiveInstances, i) end
        end
        local blur = game:GetService("Lighting"):FindFirstChild("NebubloxBlur")
        if blur then blur:Destroy() end
        if OpenBtnContainer then pcall(function() OpenBtnContainer:Destroy() end) end
        if ScreenGui then ScreenGui:Destroy() end
    end

    WindowObj.ActiveInstances.MainFrame = MainFrame
    WindowObj.ActiveInstances.PageView = PageView
    WindowObj.ActiveInstances.TabContainer = TabContainer

    return WindowObj
end

