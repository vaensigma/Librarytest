local function StringToColorSequence(str)
    if not str or type(str) ~= "string" then return nil end
    local values = {}
    for val in str:gmatch("[%d%.%-%+eE]+") do table.insert(values, tonumber(val)) end
    if #values < 4 then return nil end
    local keypoints = {}
    local step = (#values % 5 == 0) and 5 or 4
    for i = 1, #values, step do
        if values[i] and values[i + 1] and values[i + 2] and values[i + 3] then
            pcall(function()
                table.insert(keypoints, ColorSequenceKeypoint.new(
                    math.clamp(values[i], 0, 1),
                    Color3.new(math.clamp(values[i + 1], 0, 1), math.clamp(values[i + 2], 0, 1), math.clamp(values[i + 3], 0, 1))
                ))
            end)
        end
    end
    if #keypoints < 2 then return nil end
    return ColorSequence.new(keypoints)
end

local function ApplyTextGradient(label, colors)
    if not colors then return end
    local gradColor = colors
    if type(gradColor) == "string" then
        if gradColor:sub(1, 1) == "#" then
            local c = ParseColor(gradColor)
            gradColor = c and ColorSequence.new(c) or nil
        elseif gradColor ~= "Holographic" and (gradColor:find("%s") or gradColor:find("%d")) then
            gradColor = StringToColorSequence(gradColor)
        end
    elseif typeof(gradColor) == "Color3" then
        gradColor = ColorSequence.new(gradColor)
    end
    if gradColor then
        label.TextColor3 = Color3.new(1, 1, 1)
        local isHolographic = gradColor == "Holographic"
        local gradientColor
        if typeof(gradColor) == "ColorSequence" then
            gradientColor = gradColor
        elseif isHolographic then
            gradientColor = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Nebublox.Theme.PrimaryAccent),
                ColorSequenceKeypoint.new(1, Nebublox.Theme.SecondaryAccent)
            })
        elseif typeof(gradColor) == "table" and #gradColor >= 2 then
            gradientColor = ColorSequence.new({
                ColorSequenceKeypoint.new(0, gradColor[1]),
                ColorSequenceKeypoint.new(1, gradColor[2])
            })
        else
            gradientColor = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Nebublox.Theme.PrimaryAccent),
                ColorSequenceKeypoint.new(1, Nebublox.Theme.SecondaryAccent)
            })
        end
        local existing = label:FindFirstChildOfClass("UIGradient")
        local gradient = existing or Create("UIGradient", {Color = gradientColor, Parent = label})
        gradient.Color = gradientColor

        if isHolographic and not gradient:GetAttribute("Animating") then
            gradient:SetAttribute("Animating", true)
            local conn
            conn = RunService.RenderStepped:Connect(function(dt)
                if not gradient or not gradient.Parent then conn:Disconnect() return end
                gradient.Rotation = (gradient.Rotation + (dt * 120)) % 360
            end)
            label.Destroying:Connect(function() if conn then conn:Disconnect() end end)
        end
    end
end

-- Zamiana kolorow w calym drzewie (zmiana palety)
local COLOR_PROPS = {"BackgroundColor3", "TextColor3", "ImageColor3", "ScrollBarImageColor3", "Color", "PlaceholderColor3"}
local function sameColor(a, b)
    return typeof(a) == "Color3" and typeof(b) == "Color3"
        and math.abs(a.R - b.R) < 0.004 and math.abs(a.G - b.G) < 0.004 and math.abs(a.B - b.B) < 0.004
end

local function RecolorTree(root, map)
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("UIGradient") then
            local changed, new = false, {}
            for i, k in ipairs(d.Color.Keypoints) do
                local c = k.Value
                for _, m in ipairs(map) do
                    if sameColor(c, m[1]) then c = m[2]; changed = true; break end
                end
                new[i] = ColorSequenceKeypoint.new(k.Time, c)
            end
            if changed then d.Color = ColorSequence.new(new) end
        else
            for _, p in ipairs(COLOR_PROPS) do
                local ok, val = pcall(function() return d[p] end)
                if ok and typeof(val) == "Color3" then
                    for _, m in ipairs(map) do
                        if sameColor(val, m[1]) then pcall(function() d[p] = m[2] end); break end
                    end
                end
            end
        end
    end
end

