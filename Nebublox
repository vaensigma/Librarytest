local function GetTranslation(text)
    if not text or text == "" then return nil end
    if Translations[text] then return Translations[text] end
    local trimmed = text:match("^%s*(.-)%s*$")
    return Translations[trimmed]
end

local function TranslateAllUI()
    local isPT = genv.Nebublox_Language == "PT"
    local list = genv.Nebublox_TrackedLabels
    -- kompaktowanie zniszczonych
    for i = #list, 1, -1 do
        if list[i].dead then table.remove(list, i) end
    end
    for _, item in ipairs(list) do
        pcall(function()
            local inst = item.inst
            if not inst or not inst.Parent then return end
            local tr = Translations[item.originalText]
            if not tr then return end
            local cur = inst[item.prop]
            if isPT then
                if cur == item.originalText then inst[item.prop] = tr end
            else
                if cur == tr then inst[item.prop] = item.originalText end
            end
        end)
    end
end

