function Nebublox:Notify(data)
    if type(data) == "string" then data = { Title = "Nebublox", Content = data } end
    data = data or {}
    local title = data.Title or "Notification"
    local content = data.Content or ""
    local duration = data.Duration or 3.5
    local nType = data.Type or "info"
    local T = Nebublox.Theme

    local accent = T.PrimaryAccent
    if nType == "success" then accent = T.Success
    elseif nType == "warning" then accent = T.Warning
    elseif nType == "error" then accent = T.Error end
    local glyph = (nType == "success" and "✔") or (nType == "warning" and "▲") or (nType == "error" and "✖") or "●"

    local holder = EnsureNotifContainer()
    if not holder then return end

    -- limit 6 naraz
    local slots = {}
    for _, c in ipairs(holder:GetChildren()) do if c:IsA("Frame") then table.insert(slots, c) end end
    if #slots >= 6 then slots[1]:Destroy() end

    local slot = Create("Frame", {
        Name = "Slot", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Parent = holder
    })
    local card = Create("Frame", {
        Name = "Card", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = T.Surface, BackgroundTransparency = 0.1, ClipsDescendants = true,
        Position = UDim2.new(1, 350, 0, 0), Parent = slot
    }, {
        Create("UICorner", {CornerRadius = T.CornerRadius}),
        Create("UIStroke", {Color = accent, Thickness = 1.5}),
        Create("Frame", {Name = "GlowBar", Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = accent, BorderSizePixel = 0}),
        Create("Frame", {
            Name = "Body", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1
        }, {
            Create("UIPadding", {PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 10)}),
            Create("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder}),
            Create("TextLabel", {
                Name = "TitleLabel", Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 1, BackgroundTransparency = 1, Text = "<font color='#" .. accent:ToHex() .. "'>" .. glyph .. "</font>  " .. title,
                Font = T.FontBold, TextSize = 14, TextColor3 = T.TextHeader, TextXAlignment = Enum.TextXAlignment.Left
            }),
            Create("TextLabel", {
                Name = "ContentLabel", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
                BackgroundTransparency = 1, Text = content, Font = T.FontBody, TextSize = 12, TextColor3 = T.TextDim,
                TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true
            }),
        }),
        Create("Frame", {
            Name = "ProgressBar", Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 1, -3),
            BackgroundColor3 = accent, BorderSizePixel = 0
        }),
        Create("TextButton", {Name = "Dismiss", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 10})
    })

    local closed = false
    local function close()
        if closed then return end
        closed = true
        local t = Tween(card, {Position = UDim2.new(1, 350, 0, 0)}, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        if t then
            t.Completed:Connect(function() pcall(function() slot:Destroy() end) end)
        else
            pcall(function() slot:Destroy() end)
        end
    end

    card.Dismiss.MouseButton1Click:Connect(close)
    Tween(card, {Position = UDim2.new(0, 0, 0, 0)}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    Tween(card.ProgressBar, {Size = UDim2.new(0, 0, 0, 3)}, duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    task.delay(duration, close)
end

