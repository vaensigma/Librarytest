function Nebublox._WireTab(win, tab)
    for _, comp in ipairs({ "Section", "Label", "Paragraph", "Button", "Toggle", "Slider", "Dropdown", "TextBox" }) do
        local fnName = "Create" .. comp
        tab[fnName] = function(data, a, b, c)
