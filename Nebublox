        Create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 16),
            BackgroundTransparency = 1,
            Text = "Nebublox v" .. Nebublox.Version .. "  •  " .. GetExecutorName() .. "  •  RightShift to toggle",
            Font = T.Font,
            TextSize = 12,
            TextColor3 = T.TextDim,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = banner,
        })

        -- stats grid
        local grid = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Parent = tab.Page,
        })
        local gridLayout = Create("UIGridLayout", {
            CellSize = UDim2.new(0.5, -6, 0, 74),
            CellPadding = UDim2.new(0, 12, 0, 12),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = grid,
        })
        local function StatCard(icon, label, getOrder)
            local card = Create("Frame", {
                BackgroundColor3 = T.Card,
                Parent = grid,
            })
            Round(card, 12)
            Stroke(card, T.Stroke, 1, 0.5)
            Create("TextLabel", {
                Size = UDim2.new(0, 26, 0, 26),
                Position = UDim2.new(0, 14, 0, 12),
                BackgroundTransparency = 1,
                Text = icon,
                TextSize = 18,
                Parent = card,
            })
            Create("TextLabel", {
                Size = UDim2.new(1, -58, 0, 14),
                Position = UDim2.new(0, 48, 0, 12),
                BackgroundTransparency = 1,
                Text = label,
                Font = T.Font,
                TextSize = 11,
                TextColor3 = T.TextDim,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = card,
            })
            local value = Create("TextLabel", {
                Size = UDim2.new(1, -58, 0, 20),
                Position = UDim2.new(0, 48, 0, 30),
                BackgroundTransparency = 1,
                Text = "...",
                Font = T.FontBold,
                TextSize = 14,
                TextColor3 = T.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = card,
            })
            return value
        end
        local gameVal    = StatCard("🎮", "GAME")
        local serverVal  = StatCard("🌐", "SERVER")
        local playersVal = StatCard("👥", "PLAYERS")
        local fpsVal     = StatCard("⚡", "FPS")

        -- performance graph
        local graphCard = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 150),
            BackgroundColor3 = T.Card,
            Parent = tab.Page,
        })
        Round(graphCard, 12)
        Stroke(graphCard, T.Stroke, 1, 0.5)
        Create("TextLabel", {
            Size = UDim2.new(1, -24, 0, 16),
            Position = UDim2.new(0, 14, 0, 10),
            BackgroundTransparency = 1,
            Text = "📊 PERFORMANCE",
            Font = T.FontBold,
            TextSize = 12,
            TextColor3 = T.TextDim,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = graphCard,
        })
        local graphArea = Create("Frame", {
            Size = UDim2.new(1, -28, 1, -52),
            Position = UDim2.new(0, 14, 0, 34),
            BackgroundColor3 = T.Sidebar,
            BorderSizePixel = 0,
            ClipsDescendants = true,
            Parent = graphCard,
        })
        Round(graphArea, 8)
        local bars = {}
        local BAR_COUNT = 60
        for i = 1, BAR_COUNT do
            local bar = Create("Frame", {
                Size = UDim2.new(1 / BAR_COUNT, -1.5, 0, 4),
                Position = UDim2.new((i - 1) / BAR_COUNT, 0, 1, -4),
                AnchorPoint = Vector2.new(0, 1),
                BackgroundColor3 = T.Accent,
                BackgroundTransparency = 0.3,
                BorderSizePixel = 0,
                Parent = graphArea,
            })
            Round(bar, 1)
            bars[i] = bar
        end

        -- live updater
        task.spawn(function()
            local gameId = ""
            pcall(function() gameId = game.Name end)
            if gameId == "" then gameId = "Place " .. tostring(game.PlaceId) end
            local jobText = (game.JobId ~= "") and game.JobId:sub(1, 8) .. "…" or "Private"
            while tab.Page and tab.Page.Parent do
                pcall(function()
                    gameVal.Text = gameId
                    serverVal.Text = jobText
                    playersVal.Text = tostring(#Players:GetPlayers()) .. " / " .. tostring(Players.MaxPlayers)
                    fpsVal.Text = tostring(FPS.value) .. " FPS"
                    -- graph
                    local areaH = graphArea.AbsoluteSize.Y - 8
                    local n = #FPS.history
                    for i = 1, BAR_COUNT do
                        local idx = n - BAR_COUNT + i
                        local fps = idx > 0 and FPS.history[idx] or nil
                        local h = fps and math.clamp(fps / 120, 0.04, 1) * areaH or 4
                        bars[i].Size = UDim2.new(1 / BAR_COUNT, -1.5, 0, h)
                        if fps then
                            if fps >= 45 then
                                bars[i].BackgroundColor3 = T.Success
                            elseif fps >= 25 then
                                bars[i].BackgroundColor3 = T.Warning
                            else
                                bars[i].BackgroundColor3 = T.Error
                            end
                        end
                    end
                end)
                task.wait(0.5)
            end
        end)
    end

    function self:Destroy()
        pcall(function() ScreenGui:Destroy() end)
        pcall(function() Nebublox.NotifGui:Destroy() end)
        for _, c in ipairs(Nebublox.Conns) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(Nebublox.Conns)
        CurrentWindow = nil
    end

    -- register component builders on tab
    Nebublox._AttachComponents(self)

    CurrentWindow = self
    return self
end

-- ==================================================================
--  COMPONENTS (attached to every tab)
-- ==================================================================
function Nebublox._AttachComponents(win)

    local function GetCard(tab)
        if tab.CurrentCard then return tab.CurrentCard.Holder end
        -- auto-create default card
        return nil
    end

    local function NewCard(tab, title)
        tab.ElementOrder = tab.ElementOrder + 1
        local card = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = T.Card,
            LayoutOrder = tab.ElementOrder,
            Parent = tab.Page,
        })
        Round(card, 12)
        Stroke(card, T.Stroke, 1, 0.5)
        if title and title ~= "" then
            Create("TextLabel", {
                Size = UDim2.new(1, -28, 0, 16),
                Position = UDim2.new(0, 14, 0, 12),
                BackgroundTransparency = 1,
                Text = title,
                Font = T.FontBold,
                TextSize = 12,
                TextColor3 = T.Accent,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = card,
            })
        end
        local holder = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Parent = card,
        })
        local topPad = (title and title ~= "") and 34 or 8
        Create("UIPadding", {
            PaddingTop = UDim.new(0, topPad),
            PaddingBottom = UDim.new(0, 8),
            PaddingLeft = UDim.new(0, 10),
            PaddingRight = UDim.new(0, 10),
            Parent = holder,
        })
        Create("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = holder,
        })
        local cardObj = { Card = card, Holder = holder }
        tab.CurrentCard = cardObj
        return cardObj
    end

    local function GetHolder(tab)
        if tab.CurrentCard then
            return tab.CurrentCard.Holder
        end
        return NewCard(tab, "").Holder
    end

    local function NextOrder(tab)
        tab.ElementOrder = tab.ElementOrder + 1
        return tab.ElementOrder
    end

    -- ============ SECTION ============
    function win:CreateSection(tab, name)
        NewCard(tab, name or "")
    end

    -- ============ LABEL ============
    function win:CreateLabel(tab, text)
        local l = Create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Text = text or "",
            Font = T.Font,
            TextSize = 13,
            TextColor3 = T.TextDim,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            LayoutOrder = NextOrder(tab),
            Parent = GetHolder(tab),
        })
        return l
    end

    -- ============ PARAGRAPH ============
    function win:CreateParagraph(tab, data)
        data = data or {}
        local holder = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = T.Surface,
            LayoutOrder = NextOrder(tab),
            Parent = GetHolder(tab),
        })
        Round(holder, 8)
        Create("UIPadding", {
            PaddingTop = UDim.new(0, 10),
            PaddingBottom = UDim.new(0, 10),
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
            Parent = holder,
        })
        Create("UIListLayout", { Padding = UDim.new(0, 4), Parent = holder })
        Create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 16),
            BackgroundTransparency = 1,
            Text = data.Title or "",
            Font = T.FontBold,
            TextSize = 13,
            TextColor3 = T.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
