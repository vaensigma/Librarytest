function Nebublox:Notify(data)
    if type(data) == "string" then data = { Content = data } end
    data = data or {}
    local title = data.Title or "Nebublox"
    local content = data.Content or ""
    local duration = data.Duration or 3.5
    local nType = data.Type or "info"

    local accent = T.Accent
    if nType == "success" then accent = T.Success end
    if nType == "warning" then accent = T.Warning end
    if nType == "error" then accent = T.Error end
    local glyph = "●"
    if nType == "success" then glyph = "✔" end
    if nType == "warning" then glyph = "▲" end
    if nType == "error" then glyph = "✖" end

    local cards = {}
    for _, c in ipairs(NotifHolder:GetChildren()) do
        if c:IsA("Frame") then table.insert(cards, c) end
    end
    if #cards >= 6 then pcall(function() cards[1]:Destroy() end) end

    local slot = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = NotifHolder,
    })
    local card = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = T.Surface,
        ClipsDescendants = true,
        Position = UDim2.new(1, 340, 0, 0),
        Parent = slot,
    })
    Round(card, 10)
    Stroke(card, accent, 1.5, 0.2)
    Create("Frame", {
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        Parent = card,
    })
    local body = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = card,
    })
    Create("UIPadding", {
        PaddingTop = UDim.new(0, 8),
        PaddingBottom = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 14),
        PaddingRight = UDim.new(0, 10),
        Parent = body,
    })
    Create("UIListLayout", { Padding = UDim.new(0, 2), Parent = body })
    Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        RichText = true,
        Text = '<font color="#' .. accent:ToHex() .. '">' .. glyph .. '</font>  ' .. title,
        Font = T.FontBold,
        TextSize = 14,
        TextColor3 = T.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = body,
    })
    Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Text = content,
        Font = T.Font,
        TextSize = 12,
        TextColor3 = T.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        Parent = body,
    })
    local bar = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 3),
        Position = UDim2.new(0, 0, 1, -3),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        Parent = card,
    })
    local dismiss = Create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 10,
        Parent = card,
    })

    local closed = false
    local function close()
        if closed then return end
        closed = true
        local t = Tween(card, { Position = UDim2.new(1, 340, 0, 0) }, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        if t then
            t.Completed:Connect(function() pcall(function() slot:Destroy() end) end)
        else
            pcall(function() slot:Destroy() end)
        end
    end

    dismiss.MouseButton1Click:Connect(close)
    Tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    Tween(bar, { Size = UDim2.new(0, 0, 0, 3) }, duration, Enum.EasingStyle.Linear)
    task.delay(duration, close)
end

