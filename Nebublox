    if self._schedulerConnection then self._schedulerConnection:Disconnect() end
    for i = #self.Windows, 1, -1 do pcall(function() self.Windows[i]:Destroy() end) end
    for _, inst in ipairs(self.ActiveInstances) do pcall(function() inst:Destroy() end) end
    table.clear(self.ActiveInstances)
    table.clear(self.Flags)
    pcall(Nebublox.Utils.Cleanup)
    local blur = game:GetService("Lighting"):FindFirstChild("NebubloxBlur")
    if blur then blur:Destroy() end
    if genv.Nebublox_KeyConn then pcall(function() genv.Nebublox_KeyConn:Disconnect() end); genv.Nebublox_KeyConn = nil end
    genv.Nebublox_Binding = false
    genv.Nebublox_SessionID = nil
    NotifContainer = nil
end
