        BackgroundTransparency = 1,
        Text = data.Name or "Keybind",
        Font = T.Font,
        TextSize = 13,
        TextColor3 = T.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    AddTextStroke(l)
