            local dataFileName = "NebuState_AutoSave.json"
            local function loadData()
                local s, res = pcall(function()
                    if isfile(dataFileName) then return HttpService:JSONDecode(readfile(dataFileName)) end
                end)
                return (s and type(res) == "table") and res or {}
            end
            local function saveData(data)
                pcall(function()
                    local safeData = {}
                    for k, val in pairs(data) do
                        local tv = type(val)
                        if (tv == "boolean" or tv == "number" or tv == "string" or tv == "table")
                            and k ~= "Connections" and k ~= "MovementConn" and k ~= "Toggles" and k ~= "GachaToggles" then
                            safeData[k] = val
                        end
                    end
                    writefile(dataFileName, HttpService:JSONEncode(safeData))
                end)
            end
            if State then
                pcall(function()
                    for k, val in pairs(loadData()) do
                        if State[k] == nil or type(State[k]) == type(val) then State[k] = val end
                    end
                end)
            end
            while State and State.Nebublox_Running ~= false and not self._destroyed do
                task.wait(10)
                saveData(State)
            end
        end)

