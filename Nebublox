    AddTextStroke(l)

    local switch = Create("Frame", {
        Size = UDim2.new(0, 42, 0, 22),
        Position = UDim2.new(1, -12, 0.5, 0),
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = T.SurfaceLight,
        BorderSizePixel = 0,
        Parent = row,
    })
    Round(switch, 11)
    local swStroke = Stroke(switch, T.Stroke, 1, 0.3)
    local knob = Create("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(0, 3, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = T.TextDim,
        BorderSizePixel = 0,
        Parent = switch,
    })
    Round(knob, 8)

    local el = { Type = "Toggle" }
    local function render(v, silent)
        currentValue = v
        if v then
            Tween(switch, { BackgroundColor3 = T.Accent2 }, 0.2)
            Tween(knob, { Position = UDim2.new(1, -19, 0.5, 0), BackgroundColor3 = T.Text }, 0.2)
            swStroke.Color = T.Accent
        else
            Tween(switch, { BackgroundColor3 = T.SurfaceLight }, 0.2)
            Tween(knob, { Position = UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = T.TextDim }, 0.2)
            swStroke.Color = T.Stroke
        end
        if not silent then Fire(data.Callback, v) end
    end

    el.Set = function(_, v, silent) render(v == true, silent) end
    el.Get = function() return currentValue end
    if flag then Nebublox.Flags[flag] = el end

    row.MouseButton1Click:Connect(function()
        render(not currentValue)
    end)
    render(currentValue, true)
    return el
end

