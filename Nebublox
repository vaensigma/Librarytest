function ComponentManager:CreateProgressBar(data)
    local T = Nebublox.Theme
    local name = data.Name or "Progress"
    local max = data.Max or 100
    local value = math.clamp(data.Default or 0, 0, max)
    local frame = Create("Frame", {
        Name = name, Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = T.SurfaceLight, BackgroundTransparency = T.GlassTransparency, Parent = ParentOf(self)
    }, {
        Create("UICorner", {CornerRadius = T.CornerRadius}),
        Create("UIStroke", {Color = T.PrimaryAccent, Thickness = 1, Transparency = 0.4}),
        Create("TextLabel", {
            Name = "Title", Size = UDim2.new(1, -90, 0, 20), Position = UDim2.new(0, 12, 0, 4), BackgroundTransparency = 1, Text = name,
            Font = T.FontBold, TextSize = 13, TextColor3 = T.TextNormal, TextXAlignment = Enum.TextXAlignment.Left
        }),
        Create("TextLabel", {
            Name = "Val", Size = UDim2.new(0, 80, 0, 20), Position = UDim2.new(1, -10, 0, 4), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1,
            Text = "", Font = T.FontBold, TextSize = 12, TextColor3 = T.PrimaryAccent, TextXAlignment = Enum.TextXAlignment.Right
        }),
        Create("Frame", {Name = "Track", Size = UDim2.new(1, -24, 0, 8), Position = UDim2.new(0, 12, 0, 30), BackgroundColor3 = T.Background}, {
            Create("UICorner", {CornerRadius = UDim.new(1, 0)}),
            Create("Frame", {Name = "Fill", Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1)}, {
                Create("UICorner", {CornerRadius = UDim.new(1, 0)}),
                Create("UIGradient", {Color = ColorSequence.new(T.SecondaryAccent, T.PrimaryAccent)})
            })
        })
    })
    local function render(animate)
        local f = math.clamp(value / max, 0, 1)
        if animate then Tween(frame.Track.Fill, {Size = UDim2.new(f, 0, 1, 0)}, 0.25) else frame.Track.Fill.Size = UDim2.new(f, 0, 1, 0) end
        frame.Val.Text = data.Format and tostring(data.Format(value, max)) or (math.floor(f * 100 + 0.5) .. "%")
    end
    render(false)
    Register(self, name, "ProgressBar", frame)
    local obj = { Frame = frame }
    function obj:Set(v, m) if m then max = m end value = math.clamp(tonumber(v) or 0, 0, max); render(true) end
    function obj:Get() return value end
    return obj
end

