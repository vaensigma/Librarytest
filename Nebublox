local function Fire(cb, ...)
    if type(cb) ~= "function" then return end
    task.spawn(function(...)
        local ok, err = pcall(cb, ...)
        if not ok then warn("[Nebublox] Callback error: " .. tostring(err)) end
    end, ...)
end

local function Create(class, props, children)
    if (class == "UIStroke" and not SupportsUIStroke) or (class == "UICorner" and not SupportsUICorner) then
        local f = Instance.new("Frame"); f.Visible = false; f.Name = class .. "_Fallback"; return f
    end
    local ok, inst = pcall(Instance.new, class)
    if not ok or not inst then
        local f = Instance.new("Frame"); f.Visible = false; f.Name = class .. "_Error"; return f
    end

    local isText = (class == "TextLabel" or class == "TextButton" or class == "TextBox")
    if isText then
        pcall(function() inst.RichText = true end)
        local thick = Nebublox.Theme.TextStroke or 0
        if thick > 0 then
            pcall(function()
                local stroke = Instance.new("UIStroke")
                stroke.Color = Color3.new(0, 0, 0)
                stroke.Thickness = thick
                stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
                stroke.Parent = inst
            end)
        end
    end

    local parent = nil
    for k, v in pairs(props or {}) do
        if k == "Parent" then
            parent = v
        else
            pcall(function() inst[k] = v end)
        end
    end

    if type(children) == "table" then
        for i = 1, #children do
            local child = children[i]
            if typeof(child) == "Instance" then pcall(function() child.Parent = inst end) end
        end
    elseif typeof(children) == "Instance" then
        parent = parent or children
    end

    if parent then pcall(function() inst.Parent = parent end) end

    if isText then
        pcall(function()
            local original = props and (props.Text or props.PlaceholderText)
            if original and type(original) == "string" and original ~= "" then
                local prop = props.Text and "Text" or "PlaceholderText"
                local item = { inst = inst, originalText = original, prop = prop }
                table.insert(genv.Nebublox_TrackedLabels, item)
                inst.Destroying:Connect(function() item.dead = true end)
                if genv.Nebublox_Language == "PT" then
                    local trans = GetTranslation(original)
                    if trans then inst[prop] = trans end
                end
            end
        end)
    end
    return inst
end

local function Tween(obj, props, time, style, dir)
    if not obj or not obj.Parent then return nil end
    local info = TweenInfo.new(time or 0.3, style or Enum.EasingStyle.Sine, dir or Enum.EasingDirection.Out)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local function ParseColor(c)
    if typeof(c) == "Color3" then return c end
    if type(c) == "string" then
        local ok, res = pcall(Color3.fromHex, c)
        if ok and typeof(res) == "Color3" then return res end
    end
    return nil
end

local function SafeSetFont(obj, font)
