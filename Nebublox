        for _, tab in ipairs(win.Tabs) do
            if tab.NavButton then
                tab.NavButton.Visible = (q == "") or (tab.Name:lower():find(q, 1, true) ~= nil)
            end
        end
    end)

    -- ===== dragging =====
    do
        local dragging, dragStart, startPos = false, nil, nil
        Track(header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = main.Position
            end
        end))
        Track(UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                main.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end))
        Track(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))
    end

    -- ===== FPS chip loop =====
    task.spawn(function()
        while win.Frame and win.Frame.Parent do
            pcall(function()
                fpsChip.Text = tostring(FPS.value) .. " FPS"
                if FPS.value >= 45 then
                    fpsChip.TextColor3 = T.Success
                elseif FPS.value >= 25 then
                    fpsChip.TextColor3 = T.Warning
                else
                    fpsChip.TextColor3 = T.Error
                end
            end)
            task.wait(0.5)
        end
    end)

    -- ===== select tab =====
    local function SelectTab(tab)
        for _, t in ipairs(win.Tabs) do
            t.Page.Visible = false
            if t.NavAccent then t.NavAccent.Visible = false end
            t.NavButton.BackgroundColor3 = T.Sidebar
            t.NavButton.BackgroundTransparency = 0
            t.NavLabel.TextColor3 = T.TextDim
            if t.NavIcon then t.NavIcon.TextTransparency = 0.4 end
        end
        tab.Page.Visible = true
        if tab.NavAccent then tab.NavAccent.Visible = true end
        tab.NavButton.BackgroundColor3 = T.SurfaceLight
        tab.NavButton.BackgroundTransparency = T.Glass
        tab.NavLabel.TextColor3 = T.Accent
        if tab.NavIcon then tab.NavIcon.TextTransparency = 0 end
        pageTitle.Text = tab.Name
        win.CurrentTab = tab
    end

    -- ===== tab builder =====
    local tabOrder = 0
    local function BuildTab(name, icon)
        tabOrder = tabOrder + 1
        local tab = {
            Name = name,
            order = 0,
            currentCard = nil,
        }

        local navBtn = Create("TextButton", {
            Name = "Nav_" .. name,
            Size = UDim2.new(1, 0, 0, 42),
            BackgroundColor3 = T.Sidebar,
            Text = "",
            AutoButtonColor = false,
            ClipsDescendants = true,
            LayoutOrder = tabOrder,
            Parent = navScroll,
        })
        Round(navBtn, 8)
        local navAccent = Create("Frame", {
            Size = UDim2.new(0, 3, 0, 20),
            Position = UDim2.new(0, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = T.Accent,
            BorderSizePixel = 0,
            Visible = false,
            Parent = navBtn,
        })
        Round(navAccent, 2)
        local navIcon = Create("TextLabel", {
            Size = UDim2.new(0, 22, 0, 22),
            Position = UDim2.new(0, 14, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundTransparency = 1,
            Text = icon or "◈",
            TextSize = 15,
            Font = T.Font,
            TextColor3 = T.TextDim,
            TextTransparency = 0.4,
            Parent = navBtn,
        })
        local navLabel = Create("TextLabel", {
            Size = UDim2.new(1, -52, 0, 20),
            Position = UDim2.new(0, 44, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundTransparency = 1,
            Text = name,
            Font = T.FontBold,
            TextSize = 13,
            TextColor3 = T.TextDim,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = navBtn,
        })
        AddTextStroke(navLabel)

        local page = Create("ScrollingFrame", {
            Name = "Page_" .. name,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = T.Accent2,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
            Parent = content,
        })
        Create("UIPadding", {
            PaddingTop = UDim.new(0, 2),
            PaddingBottom = UDim.new(0, 2),
            Parent = page,
        })
        Create("UIListLayout", {
            Padding = UDim.new(0, 10),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = page,
        })

        tab.NavButton = navBtn
        tab.NavAccent = navAccent
        tab.NavIcon = navIcon
        tab.NavLabel = navLabel
        tab.Page = page

        navBtn.MouseButton1Click:Connect(function() SelectTab(tab) end)
        navBtn.MouseEnter:Connect(function()
            if win.CurrentTab ~= tab then
                Tween(navBtn, { BackgroundColor3 = T.Surface }, 0.15)
            end
        end)
        navBtn.MouseLeave:Connect(function()
            if win.CurrentTab ~= tab then
                Tween(navBtn, { BackgroundColor3 = T.Sidebar }, 0.15)
            end
        end)

        -- ===== component methods (direct closures — bulletproof) =====
        function tab:CreateSection(d) CompSection(self, d) end
        function tab:CreateLabel(d) return CompLabel(self, d) end
        function tab:CreateParagraph(d) return CompParagraph(self, d) end
        function tab:CreateButton(d) return CompButton(self, d) end
        function tab:CreateToggle(d) return CompToggle(self, d) end
        function tab:CreateSlider(d) return CompSlider(self, d) end
        function tab:CreateDropdown(d) return CompDropdown(self, d) end
        function tab:CreateTextBox(d) return CompTextBox(self, d) end
        function tab:CreateKeybind(d) return CompKeybind(self, d) end

        table.insert(win.Tabs, tab)

        -- Dashboard auto-build
        if name:lower() == "dashboard" then
            Nebublox:BuildDashboard(win, tab)
        end

        if #win.Tabs == 1 then
            SelectTab(tab)
        end

        return tab
    end

    function win:CreateTab(name, icon)
        return BuildTab(name, icon)
    end

    function win:Destroy()
        win.Destroyed = true
        pcall(function() ScreenGui:Destroy() end)
        for _, c in ipairs(Nebublox.Conns) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(Nebublox.Conns)
        CurrentWindow = nil
    end

    CurrentWindow = win
    return win
end

