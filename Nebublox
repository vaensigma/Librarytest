Nebublox.Storage = { FileName = "Nebublox_Config.json" }

local function SafeName(n)
    n = tostring(n or "default"):gsub("[^%w_%- ]", "")
    if n == "" then n = "default" end
    return n
end

local function Serialize(v)
    local t = typeof(v)
    if t == "EnumItem" then return v.Name end
    if t == "Color3" then return "#" .. v:ToHex() end
    if t == "table" then
        if v[1] == nil and v.Name then return v.Name end
        local out = {}
        for i, x in ipairs(v) do out[i] = Serialize(x) end
        return out
    end
    return v
end

function Nebublox:GetConfigs(folderName)
    local configs = {}
    pcall(function()
        for _, f in ipairs(listfiles(folderName or self.ConfigFolder)) do
            local name = f:match("([^/\\]+)%.json$")
            if name then table.insert(configs, name) end
        end
    end)
    if #configs == 0 then table.insert(configs, "default") end
    table.sort(configs)
    return configs
end

function Nebublox.Storage:Save(data)
    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
    if ok then pcall(writefile, self.FileName, encoded) end
end
function Nebublox.Storage:Load()
    if isfile(self.FileName) then
        local ok, decoded = pcall(HttpService.JSONDecode, HttpService, readfile(self.FileName))
        return ok and decoded or {}
    end
    return {}
end

function Nebublox:SaveConfig(folderName, fileName)
    folderName = folderName or self.ConfigFolder
    fileName = SafeName(fileName)
    local states = {}
    for flag, element in pairs(self.Flags) do
        if type(element.GetValue) == "function" then
            local ok, val = pcall(element.GetValue, element)
            if ok and val ~= nil then states[flag] = Serialize(val) end
        end
    end
    local ok, json = pcall(HttpService.JSONEncode, HttpService, states)
    if ok and json then
        pcall(function()
            if not isfolder(folderName) then makefolder(folderName) end
            writefile(folderName .. "/" .. fileName .. ".json", json)
        end)
        return true
    end
    return false
end

function Nebublox:LoadConfig(folderName, fileName)
    folderName = folderName or self.ConfigFolder
    fileName = SafeName(fileName)
    local path = folderName .. "/" .. fileName .. ".json"
    if not isfile(path) then return false end
    local ok, decoded = pcall(HttpService.JSONDecode, HttpService, readfile(path))
    if not ok or type(decoded) ~= "table" then return false end
    for flag, value in pairs(decoded) do
        local el = self.Flags[flag]
        if el and type(el.Set) == "function" then pcall(el.Set, el, value) end
    end
    return true
end

function Nebublox:DeleteConfig(folderName, fileName)
    local path = (folderName or self.ConfigFolder) .. "/" .. SafeName(fileName) .. ".json"
    if isfile(path) then pcall(delfile, path) end
end

function Nebublox:SetAutoload(fileName)
    pcall(function()
        if not isfolder(self.ConfigFolder) then makefolder(self.ConfigFolder) end
        writefile(self.ConfigFolder .. "/_autoload.txt", SafeName(fileName))
    end)
end
-- Wywolaj PO zbudowaniu wszystkich zakladek, zeby wczytac config autoload
function Nebublox:LoadAutoConfig()
    local path = self.ConfigFolder .. "/_autoload.txt"
    if isfile(path) then
        local name = readfile(path)
        if name and name ~= "" then return self:LoadConfig(self.ConfigFolder, name) end
    end
    return false
end

function Nebublox.ServerHop()
    task.spawn(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local ok, result = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
        if ok and result and result.data then
            local servers = {}
            for _, server in ipairs(result.data) do
                if type(server) == "table" and server.playing and server.maxPlayers and server.playing < server.maxPlayers and server.id ~= game.JobId then
                    table.insert(servers, server.id)
                end
            end
            if #servers > 0 then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
                return
            end
        end
        TeleportService:Teleport(game.PlaceId, player)
    end)
end

