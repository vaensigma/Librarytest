-- ==================================================================
--  CONFIG SAVE / LOAD
-- ==================================================================
local function SafeName(n)
    n = tostring(n or "default"):gsub("[^%w_%- ]", "")
    if n == "" then n = "default" end
    return n
end

function Nebublox:SaveConfig(fileName)
    local states = {}
    for flag, el in pairs(self.Flags) do
        if type(el.Get) == "function" then
            local ok, val = pcall(el.Get, el)
            if ok and val ~= nil then states[flag] = val end
        end
    end
    local ok, json = pcall(HttpService.JSONEncode, HttpService, states)
    if ok and json then
        pcall(function()
            if not isfolder(self.ConfigFolder) then makefolder(self.ConfigFolder) end
            writefile(self.ConfigFolder .. "/" .. SafeName(fileName) .. ".json", json)
        end)
        return true
    end
    return false
end

function Nebublox:LoadConfig(fileName)
    local path = self.ConfigFolder .. "/" .. SafeName(fileName) .. ".json"
    if not isfile(path) then return false end
    local ok, decoded = pcall(HttpService.JSONDecode, HttpService, readfile(path))
    if not ok or type(decoded) ~= "table" then return false end
    for flag, value in pairs(decoded) do
        local el = self.Flags[flag]
        if el and type(el.Set) == "function" then
            pcall(el.Set, el, value, true)
        end
    end
    return true
end

function Nebublox:Destroy()
    if CurrentWindow then
        pcall(function() CurrentWindow:Destroy() end)
    end
end

return Nebublox
